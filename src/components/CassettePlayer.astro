    font-size: 1.3rem;
  }

  .cst-player-loc {
    font-size: 0.78rem;
    opacity: 0.6;
    margin-top: 0.15rem;
  }

  .cst-scrub-wrap {
    padding: 0.9rem 1.3rem 0;
    flex-shrink: 0;
