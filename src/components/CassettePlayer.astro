  .cst-lyrics-drawer {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--brown-tape) 30%, black 70%) 0%,
      color-mix(in srgb, var(--brown-tape) 14%, black 86%) 100%
    );
    border-top-left-radius: 1.4rem;
    border-top-right-radius: 1.4rem;
    box-shadow: 0 -12px 30px color-mix(in srgb, black 55%, transparent);
    transform: translateY(100%);
    transition: transform 0.32s cubic-bezier(0.2, 0.8, 0.3, 1);
    height: 78%;
    display: flex;
    flex-direction: column;
  }

  .cst-lyrics-drawer.is-open {
    transform: translateY(0%);
  }

  .cst-drawer-handle {
    width: 36px;
    height: 4px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--vintage-sky) 30%, transparent);
    margin: 0.7rem auto 0.3rem;
    flex-shrink: 0;
  }

  .cst-drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.3rem 1.3rem 0.6rem;
    flex-shrink: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--vintage-sky) 8%, transparent);
  }

  .cst-drawer-head h3 {
    margin: 0;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    text-transform: lowercase;
    color: var(--retro-pop);
  }

  .cst-drawer-head button {
    background: none;
    border: none;
    color: var(--vintage-sky);
    opacity: 0.6;
    font-size: 1.1rem;
