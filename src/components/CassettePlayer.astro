  .cst-secondary svg {
    width: 18px;
    height: 18px;
    opacity: 0.85;
    color: color-mix(in srgb, var(--stereo-blue) 70%, var(--vintage-sky));
  }

  .cst-lyrics-toggle {
    margin: 0.6rem 1.3rem 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    background: color-mix(in srgb, var(--vintage-sky) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--vintage-sky) 18%, transparent);
    border-radius: 999px;
    padding: 0.5rem 0;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: lowercase;
    color: var(--vintage-sky);
    cursor: pointer;
    flex-shrink: 0;
    font-family: inherit;
  }

  .cst-lyrics-toggle svg {
    width: 13px;
    height: 13px;
    transition: transform 0.25s;
