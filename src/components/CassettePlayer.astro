<script>
  // Mission 17: the official YouTube IFrame Player API loader --
  // https://www.youtube.com/iframe_api, the standard/only supported
  // mechanism for embedding a scriptable YouTube video (same category
  // as this project already loading Google Fonts via a <link> tag;
  // not an npm dependency or a copied snippet -- see
  // MISSION_17_response.md). Declared at the script's top level (not
  // inside initCassettePlayer) so it and `window.YT` survive Astro's
  // soft navigations within the same tab -- the script tag is only
  // ever injected once per page load, and `onReady` callbacks queued
  // while it's still loading are flushed once, in order.
  let ytApiLoadStarted = false;
  let ytApiReadyCallbacks: Array<() => void> = [];
  let currentVisibilityHandler: (() => void) | null = null;

  function ensureYtApiLoaded(onReady: () => void) {
    const w = window as any;
    if (w.YT && w.YT.Player) {
      onReady();
      return;
    }
    ytApiReadyCallbacks.push(onReady);
    if (ytApiLoadStarted) return;
    ytApiLoadStarted = true;
    const previous = w.onYouTubeIframeAPIReady;
    w.onYouTubeIframeAPIReady = () => {
      previous?.();
      const callbacks = ytApiReadyCallbacks;
      ytApiReadyCallbacks = [];
      callbacks.forEach((cb) => cb());
    };
    const tag = document.createElement("script");
    tag.src = "https://www.youtube.com/iframe_api";
    document.head.appendChild(tag);
  }

  // Mission 14: shelf -> cassette -> player flow. Ported from the
  // reference's own JS structure: showScreen() only ever toggles
  // `.is-active` (see the .is-behind CSS-rule comment above for why).
  function initCassettePlayer() {
    const root = document.querySelector<HTMLElement>(".cst");
    if (!root) return;

    const screenShelf = root.querySelector<HTMLElement>("#cstScreenShelf");
    const screenCassette = root.querySelector<HTMLElement>("#cstScreenCassette");
    const screenPlayer = root.querySelector<HTMLElement>("#cstScreenPlayer");
    if (!screenShelf || !screenCassette || !screenPlayer) return;

    function showScreen(el: HTMLElement) {
      [screenShelf, screenCassette, screenPlayer].forEach((s) =>
        s?.classList.remove("is-active"),
      );
      el.classList.add("is-active");
    }

    const cassettePanels = Array.from(
      root.querySelectorAll<HTMLElement>(".cst-cassette-panel"),
    );
    const cassetteEyebrow = root.querySelector<HTMLElement>("#cstCassetteEyebrow");

    function openCassette(index: number) {
      cassettePanels.forEach((panel) => {
        panel.toggleAttribute("hidden", panel.dataset.cassetteIndex !== String(index));
      });
      const activePanel = cassettePanels.find(
        (panel) => panel.dataset.cassetteIndex === String(index),
      );
      const title = activePanel?.querySelector("h2")?.textContent ?? "";
      if (cassetteEyebrow) cassetteEyebrow.textContent = title;
      showScreen(screenCassette);
    }

    root.querySelectorAll<HTMLButtonElement>(".cst-box").forEach((box) => {
      box.addEventListener("click", () => {
        const index = parseInt(box.dataset.cassetteIndex ?? "0", 10);
        openCassette(index);
      });
    });

    // Lado a / lado b toggle -- scoped per-panel so each cassette keeps
    // its own independent side state.
    cassettePanels.forEach((panel) => {
      const sideBtns = Array.from(panel.querySelectorAll<HTMLButtonElement>(".cst-side-btn"));
      const tracklists = Array.from(panel.querySelectorAll<HTMLElement>(".cst-tracklist"));
      sideBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const side = btn.dataset.side;
          sideBtns.forEach((b) => b.classList.toggle("is-active", b.dataset.side === side));
          tracklists.forEach((list) =>
            list.toggleAttribute("hidden", list.dataset.side !== side),
          );
        });
      });
    });

    // Back navigation never touches audio playback (Mission 16 scope
    // item 7) -- these two handlers only ever call showScreen(), by
    // construction, so a real track playing when the user taps back
    // just keeps playing.
    root.querySelector("#cstBackToShelf")?.addEventListener("click", () => showScreen(screenShelf));
    root
      .querySelector("#cstBackToCassette")
      ?.addEventListener("click", () => showScreen(screenCassette));

    // Player screen fields are filled straight from the clicked track
    // row's own rendered text/data-* -- no separate JS data copy.
    const playerTitle = root.querySelector<HTMLElement>("#cstPlayerTitle");
    const playerLoc = root.querySelector<HTMLElement>("#cstPlayerLoc");
    const playerDur = root.querySelector<HTMLElement>("#cstPlayerDur");
    const playerElapsed = root.querySelector<HTMLElement>("#cstPlayerElapsed");
    const videoPlaceholderLabel = root.querySelector<HTMLElement>("#cstVideoPlaceholderLabel");
    const lyricsDrawerTitle = root.querySelector<HTMLElement>("#cstLyricsDrawerTitle");
    const scrubFill = root.querySelector<HTMLElement>(".cst-scrub-fill");
    const lyricsBlockEls = Array.from(root.querySelectorAll<HTMLElement>(".cst-lyrics-block"));
    const audioEl = root.querySelector<HTMLAudioElement>("#cstAudio");

    const playBtn = root.querySelector<HTMLButtonElement>("#cstPlayBtn");
    const playIcon = root.querySelector<SVGElement>("#cstPlayIcon");
    const tapOverlay = root.querySelector<HTMLElement>("#cstTapOverlay");
    const prevBtn = root.querySelector<HTMLButtonElement>("#cstPrevBtn");
    const nextBtn = root.querySelector<HTMLButtonElement>("#cstNextBtn");
    const PLAY_PATH = '<path d="M8 5v14l11-7z"></path>';
    const PAUSE_PATH = '<path d="M6 5h4v14H6zM14 5h4v14h-4z"></path>';

    // Elapsed time floors (conventional for a playback position -- it
    // should show "complete seconds so far", never visually jump ahead
    // of the actual audio). Total duration rounds instead -- flooring
    // it would silently disagree with the mission's own pre-computed
    // static `dur` values (e.g. "Tarde En La Mañana" is 305.8137s,
    // which rounds to 5:06 as specified, but floors to 5:05) once
    // `loadedmetadata` overwrites the static fallback with the real
    // value. Caught by comparing the metadata-derived label against
    // the mission's own stated duration during this mission's own
    // verification, not assumed correct.
    function formatElapsed(seconds: number): string {
      if (!isFinite(seconds) || seconds < 0) return "0:00";
      const m = Math.floor(seconds / 60);
      const s = Math.floor(seconds % 60);
      return `${m}:${String(s).padStart(2, "0")}`;
    }
    function formatDuration(seconds: number): string {
      if (!isFinite(seconds) || seconds < 0) return "0:00";
      const total = Math.round(seconds);
      const m = Math.floor(total / 60);
      const s = total % 60;
      return `${m}:${String(s).padStart(2, "0")}`;
    }

    // Single icon-update function shared by BOTH the synthetic
    // (placeholder-track) path and the real <audio> element's own
    // play/pause/ended events -- "don't duplicate the logic" applies
    // here too, not just to the Media Session handlers below.
    function updatePlayIcon(isPlaying: boolean) {
      if (playIcon) playIcon.innerHTML = isPlaying ? PAUSE_PATH : PLAY_PATH;
      tapOverlay?.classList.toggle("is-hidden", isPlaying);
    }

    // Mission 14/15's original behavior, UNCHANGED: a single boolean
    // shared across every still-placeholder track (opening a new
    // placeholder track never resets it, matching the exact prior
    // behavior this mission's acceptance criteria requires).
    let syntheticPlaying = true;
    function setSyntheticPlaying(p: boolean) {
      syntheticPlaying = p;
      updatePlayIcon(p);
    }

    // Mission 16 real-audio state -- only meaningful while a track
    // with audioSrc is loaded.
    let currentTrackHasAudio = false;
    let currentTrackKey: string | null = null;

    // Mission 17: real-video state -- only meaningful while a track
    // with videoId is loaded. `ytPlayer` is a single reused instance
    // (same pattern as `audioEl`), created lazily the first time a
    // video track is actually opened.
    let ytPlayer: any = null;
    let ytPlayerReady = false;
    let currentVideoId: string | null = null;
    let currentVideoOffset = 0;

    // Mission 18 fix: NOT a cached reference. `new YT.Player(el, ...)`
    // replaces `el` with the real <iframe> (confirmed via direct DOM
    // inspection against the real embed -- see the .cst-yt-host CSS
    // comment). A `const` captured once, before that replacement,
    // would keep pointing at the original, now-detached div forever --
    // toggling `hidden` on it would silently do nothing to the actual,
    // still-visible-on-screen iframe. Looking it up fresh by class
    // (which the replacement iframe inherits) every time it's needed
    // always finds whichever element -- div or iframe -- is currently
    // live in the DOM.
    function getYtHostEl(): HTMLElement | null {
      return root.querySelector<HTMLElement>(".cst-yt-host");
    }

    // Mission 18 fix (Problem 2, the real root cause, confirmed via
    // direct computed-style inspection against the real embed): this
    // component's CSS is scoped by Astro (a `data-astro-cid-*`
    // attribute baked into the server-rendered HTML, with selectors
    // compiled to require it). The original server-rendered div DOES
    // carry that attribute, so `.cst-yt-host { position: absolute;
    // ... }` correctly applies to it -- but the real YT.Player
    // constructor REPLACES that div with a brand-new <iframe> created
    // by YouTube's own script, which only copies the plain `id`/
    // `class` attributes, not Astro's scoping attribute. The result:
    // the scoped CSS rule's selector still matches by class name, but
    // never actually applies, because the compiled selector also
    // requires an attribute the replacement element doesn't have.
    // Measured directly: `getComputedStyle(iframe).position` came back
    // "static", not "absolute", and the iframe rendered at YouTube's
    // own default 640x360 attribute size instead of filling its box.
    // Inline styles aren't subject to CSS scoping at all, so they're
    // the reliable fix regardless of which element (div or iframe) is
    // currently live.
    function sizeYtHostEl() {
      const el = getYtHostEl();
      if (!el) return;
      el.style.position = "absolute";
      el.style.inset = "0";
      el.style.width = "100%";
      el.style.height = "100%";
      el.style.border = "0";
    }

    const placeholderScene = root.querySelector<HTMLElement>("#cstPlaceholderScene");

    function applyVideoPlayback(shouldPlay: boolean) {
      if (!ytPlayer || !ytPlayerReady) return;
      try {
        if (shouldPlay) ytPlayer.playVideo();
        else ytPlayer.pauseVideo();
      } catch {
        // This mission's sandbox cannot reach youtube.com to exercise
        // the real IFrame API (stated verification limit, Rule 2) --
        // guarded defensively rather than assumed safe in every state
        // the live player might be in.
      }
    }

    function resyncVideoToAudio() {
      if (!ytPlayer || !ytPlayerReady || !audioEl) return;
      try {
        ytPlayer.seekTo(audioEl.currentTime + currentVideoOffset, true);
      } catch {
        // See applyVideoPlayback's comment.
      }
    }

    function openVideoForTrack(videoId: string, offset: number) {
      currentVideoId = videoId;
      currentVideoOffset = offset;
      getYtHostEl()?.removeAttribute("hidden");
      placeholderScene?.setAttribute("hidden", "");
      ensureYtApiLoaded(() => {
        // The user may have switched tracks (or left this page) while
        // the API was still loading -- only proceed if this video is
        // still the one actually open. Looked up fresh here too: this
        // callback can fire well after the synchronous call above, so
        // re-querying is what guarantees we still have the live node.
        const hostEl = getYtHostEl();
        if (currentVideoId !== videoId || !hostEl) return;
        if (!ytPlayer) {
          try {
            ytPlayer = new (window as any).YT.Player(hostEl, {
              videoId,
              playerVars: {
                mute: 1,
                controls: 0,
                disablekb: 1,
                modestbranding: 1,
                playsinline: 1,
                rel: 0,
                // Mission 18 fix (Problem 1): without these, the
                // postMessage-based JS API commands below (playVideo,
                // seekTo, mute) can be silently ignored by the real
                // embed -- our own play()/seekTo() calls never throw,
                // but the iframe just sits on its native "unstarted"
                // thumbnail/play-button UI forever. `enablejsapi` is
                // normally set automatically by the YT.Player()
                // constructor, but is included explicitly here as
                // belt-and-suspenders since this exact symptom is what
                // was reported; `origin` matching the page's own
                // origin is YouTube's own documented recommendation
                // for postMessage-API embeds and is the more likely
                // actual fix, per this mission's own hypothesis.
                enablejsapi: 1,
                origin: window.location.origin,
              },
              events: {
                onReady: () => {
                  ytPlayerReady = true;
                  // Guaranteed to run after the real API has finished
                  // any element replacement, so this always finds and
                  // sizes the actual live iframe -- see sizeYtHostEl's
                  // own comment for why this can't be pure CSS.
                  sizeYtHostEl();
                  try {
                    ytPlayer.mute();
                  } catch {
                    // See applyVideoPlayback's comment.
                  }
                  resyncVideoToAudio();
                  applyVideoPlayback(!!audioEl && !audioEl.paused);
                },
              },
            });
            // Belt-and-suspenders: size immediately too, in case the
            // element replacement already happened synchronously
            // within the constructor call above (timing not
            // guaranteed by the API's own docs) -- onReady's own call
            // above is what's actually relied upon; this just avoids
            // a possible brief flash at the wrong size if it doesn't.
            sizeYtHostEl();
          } catch {
            // Construction failed for some reason this sandbox can't
            // reproduce (network-restricted, per the mission's own
            // stated verification limit) -- fall back to the
            // placeholder rather than leaving a blank box.
            hostEl.setAttribute("hidden", "");
            placeholderScene?.removeAttribute("hidden");
          }
        } else if (ytPlayerReady) {
          sizeYtHostEl();
          resyncVideoToAudio();
          applyVideoPlayback(!!audioEl && !audioEl.paused);
        }
      });
    }

    function closeVideoForTrack() {
      currentVideoId = null;
      getYtHostEl()?.setAttribute("hidden", "");
      placeholderScene?.removeAttribute("hidden");
      applyVideoPlayback(false);
    }

    // Mission 17: pausing/resuming the video on tab visibility change
    // -- the audio itself is untouched here (it's meant to keep
    // playing in the background, per Mission 16); only the (otherwise
    // browser-throttled-anyway) video iframe is paused while hidden,
    // then re-seeked to wherever the audio has gotten to before
    // resuming, rather than blindly resuming from its stale position.
    // Closes over this init's own ytPlayer/audioEl, so the previous
    // init's handler (closing over a torn-down instance) is removed
    // first -- the same dedup need as Mission 12's resize listener,
    // just via a per-init function reference since this one can't be
    // a stable top-level function like that one was.
    function handleVisibilityChange() {
      if (!currentVideoId || !ytPlayer || !ytPlayerReady) return;
      if (document.hidden) {
        applyVideoPlayback(false);
      } else if (audioEl && !audioEl.paused) {
        resyncVideoToAudio();
        applyVideoPlayback(true);
      }
    }
    if (currentVisibilityHandler) {
      document.removeEventListener("visibilitychange", currentVisibilityHandler);
    }
    currentVisibilityHandler = handleVisibilityChange;
    document.addEventListener("visibilitychange", currentVisibilityHandler);

    const realTrackRows = Array.from(
      root.querySelectorAll<HTMLButtonElement>(".cst-track-row[data-audio-src]"),
    );

    if (audioEl) {
      audioEl.addEventListener("play", () => {
        updatePlayIcon(true);
        if ("mediaSession" in navigator) navigator.mediaSession.playbackState = "playing";
        // Mission 17: audio play/pause drives video play/pause from
        // these exact same handlers -- not a forked second control
        // path (mission's own explicit instruction).
        if (currentVideoId) applyVideoPlayback(true);
      });
      audioEl.addEventListener("pause", () => {
        updatePlayIcon(false);
        if ("mediaSession" in navigator) navigator.mediaSession.playbackState = "paused";
        if (currentVideoId) applyVideoPlayback(false);
      });
      audioEl.addEventListener("ended", () => {
        updatePlayIcon(false);
        if ("mediaSession" in navigator) navigator.mediaSession.playbackState = "paused";
        if (currentVideoId) applyVideoPlayback(false);
      });
      audioEl.addEventListener("loadedmetadata", () => {
        if (currentTrackHasAudio && playerDur) playerDur.textContent = formatDuration(audioEl.duration);
      });
      audioEl.addEventListener("timeupdate", () => {
        if (!currentTrackHasAudio) return;
        const pct = audioEl.duration ? (audioEl.currentTime / audioEl.duration) * 100 : 0;
        if (scrubFill) scrubFill.style.width = `${pct}%`;
        if (playerElapsed) playerElapsed.textContent = formatElapsed(audioEl.currentTime);
        if (
          "mediaSession" in navigator &&
          "setPositionState" in navigator.mediaSession &&
          isFinite(audioEl.duration)
        ) {
          try {
            navigator.mediaSession.setPositionState({
              duration: audioEl.duration,
              position: audioEl.currentTime,
              playbackRate: audioEl.playbackRate,
            });
          } catch {
            // Some browsers throw transiently on an in-flux duration
            // (e.g. right at track switch) -- not worth surfacing.
          }
        }
        // Mission 17: correct drift without reseeking every tick --
        // only once the gap between where the video (minus its
        // offset) and the audio actually are exceeds the mission's
        // stated 0.25s tolerance.
        if (currentVideoId && ytPlayer && ytPlayerReady) {
          try {
            const videoTime = ytPlayer.getCurrentTime();
            const drift = videoTime - currentVideoOffset - audioEl.currentTime;
            if (Math.abs(drift) > 0.25) {
              ytPlayer.seekTo(audioEl.currentTime + currentVideoOffset, true);
            }
          } catch {
            // See applyVideoPlayback's comment.
          }
        }
      });
    }

    function openTrackFromRow(row: HTMLButtonElement) {
      const audioSrc = row.dataset.audioSrc;
      const videoId = row.dataset.videoId;
      const videoOffset = row.dataset.videoOffset ? parseFloat(row.dataset.videoOffset) : 0;
      const title = row.dataset.title ?? "";
      const loc = row.dataset.loc ?? "";
      const dur = row.dataset.dur ?? "";
      const cassetteTitle = row.dataset.cassetteTitle ?? "";
      const lyricsKey = row.dataset.lyricsKey ?? "";

      if (playerTitle) playerTitle.textContent = title;
      if (playerLoc) playerLoc.textContent = `grabado en ${loc} · las cintas`;
      if (videoPlaceholderLabel) videoPlaceholderLabel.textContent = `video: ${loc} (placeholder)`;
      if (lyricsDrawerTitle) lyricsDrawerTitle.textContent = `letras — ${title}`;
      lyricsBlockEls.forEach((block) =>
        block.toggleAttribute("hidden", block.dataset.lyricsKey !== lyricsKey),
      );

      if (audioSrc && audioEl) {
        // Real track: set src + play() in this same click/gesture
        // context (needed for autoplay policies), drive everything
        // from the audio element's own real events from here on.
        currentTrackHasAudio = true;
        currentTrackKey = lyricsKey;
        if (playerDur) playerDur.textContent = dur; // fallback until loadedmetadata
        if (playerElapsed) playerElapsed.textContent = "0:00";
        if (scrubFill) scrubFill.style.width = "0%";
        audioEl.src = audioSrc;
        audioEl.play().catch(() => {});
        if ("mediaSession" in navigator) {
          navigator.mediaSession.metadata = new MediaMetadata({
            title,
            artist: "Audiocassettes",
            album: cassetteTitle,
          });
        }
        // Mission 17: only "Tarde En La Mañana" has a videoId right
        // now -- every other real-audio track (currently "El Ayer")
        // falls through to closeVideoForTrack(), keeping the
        // placeholder scene exactly as Mission 14/15/16 shipped it.
        if (videoId) openVideoForTrack(videoId, videoOffset);
        else closeVideoForTrack();
      } else {
        // Placeholder track: Mission 14/15's exact visual-only
        // behavior, untouched -- and per scope item 7, switching to a
        // different track (this) is one of the few things allowed to
        // stop a real track that was playing.
        const wasPlayingReal = currentTrackHasAudio;
        currentTrackHasAudio = false;
        currentTrackKey = null;
        if (audioEl && !audioEl.paused) {
          audioEl.pause();
          if (wasPlayingReal) setSyntheticPlaying(false);
        }
        if (playerDur) playerDur.textContent = dur;
        if (playerElapsed) playerElapsed.textContent = "1:12"; // Mission 14/15's static value
        if (scrubFill) scrubFill.style.width = ""; // clears inline width, reverts to the static 32% CSS default
        if ("mediaSession" in navigator) navigator.mediaSession.metadata = null;
        closeVideoForTrack();
      }

      showScreen(screenPlayer);
    }

    root.querySelectorAll<HTMLButtonElement>(".cst-track-row").forEach((row) => {
      row.addEventListener("click", () => openTrackFromRow(row));
    });

    function goToRealTrack(delta: 1 | -1) {
      if (!currentTrackHasAudio) return; // decorative no-op for placeholder tracks, matching Mission 14/15
      const idx = realTrackRows.findIndex((r) => r.dataset.lyricsKey === currentTrackKey);
      if (idx === -1) return;
      const next = realTrackRows[(idx + delta + realTrackRows.length) % realTrackRows.length];
      openTrackFromRow(next);
    }
    prevBtn?.addEventListener("click", () => goToRealTrack(-1));
    nextBtn?.addEventListener("click", () => goToRealTrack(1));

    // Mission 18 (Problem 4): a real seekable scrubber -- tap anywhere
    // to jump, drag the fill/handle to preview then commit on release.
    // Pointer events cover mouse and touch with one code path (not the
    // older separate mouse+touch event pattern). Guarded on
    // `currentTrackHasAudio` throughout, same pattern as every other
    // real-audio feature -- a placeholder track's scrubber stays
    // exactly as inert as it's always been.
    const scrubBar = root.querySelector<HTMLElement>("#cstScrubBar");
    let isDraggingScrub = false;

    function scrubFractionFromEvent(e: PointerEvent): number {
      const rect = scrubBar!.getBoundingClientRect();
      const x = Math.min(Math.max(e.clientX - rect.left, 0), rect.width);
      return rect.width > 0 ? x / rect.width : 0;
    }

    // Preview only -- moves the visual fill/elapsed label, never
    // touches audio.currentTime (so a drag that ends up back where it
    // started, or is cancelled, never actually seeks).
    function previewScrub(fraction: number) {
      if (scrubFill) scrubFill.style.width = `${fraction * 100}%`;
      if (playerElapsed && audioEl && isFinite(audioEl.duration)) {
        playerElapsed.textContent = formatElapsed(fraction * audioEl.duration);
      }
    }

    // The single actual seek point -- called on pointerup for both a
    // plain tap (down+up, no move in between -- "immediately") and the
    // end of a real drag ("commits on release"), never during
    // pointermove. Also re-syncs the video via the exact same
    // resyncVideoToAudio() Mission 17 already uses for drift
    // correction, per this mission's own instruction not to duplicate
    // that logic.
    function commitScrub(fraction: number) {
      if (!audioEl || !currentTrackHasAudio || !isFinite(audioEl.duration)) return;
      audioEl.currentTime = fraction * audioEl.duration;
      if (currentVideoId) resyncVideoToAudio();
    }

    scrubBar?.addEventListener("pointerdown", (e) => {
      if (!currentTrackHasAudio) return;
      isDraggingScrub = true;
      scrubBar.setPointerCapture(e.pointerId);
      previewScrub(scrubFractionFromEvent(e));
    });
    scrubBar?.addEventListener("pointermove", (e) => {
      if (!isDraggingScrub || !currentTrackHasAudio) return;
      previewScrub(scrubFractionFromEvent(e));
    });
    scrubBar?.addEventListener("pointerup", (e) => {
      if (!isDraggingScrub) return;
      isDraggingScrub = false;
      if (!currentTrackHasAudio) return;
      commitScrub(scrubFractionFromEvent(e));
    });
    scrubBar?.addEventListener("pointercancel", () => {
      isDraggingScrub = false;
    });

    // Play/pause + tap-overlay: real <audio> control when a real track
    // is loaded, else Mission 14/15's exact synthetic toggle.
    playBtn?.addEventListener("click", () => {
      if (currentTrackHasAudio && audioEl) {
        if (audioEl.paused) audioEl.play().catch(() => {});
        else audioEl.pause();
      } else {
        setSyntheticPlaying(!syntheticPlaying);
      }
    });
    tapOverlay?.addEventListener("click", () => {
      if (currentTrackHasAudio && audioEl) audioEl.play().catch(() => {});
      else setSyntheticPlaying(true);
    });

    // Media Session action handlers -- registered once, calling the
    // exact same functions the on-page buttons call (no duplicated
    // logic), guarded to no-op while no real track is loaded.
    if (audioEl && "mediaSession" in navigator) {
      navigator.mediaSession.setActionHandler("play", () => {
        if (currentTrackHasAudio) audioEl.play().catch(() => {});
      });
      navigator.mediaSession.setActionHandler("pause", () => {
        if (currentTrackHasAudio) audioEl.pause();
      });
      navigator.mediaSession.setActionHandler("previoustrack", () => goToRealTrack(-1));
      navigator.mediaSession.setActionHandler("nexttrack", () => goToRealTrack(1));
    }

    // Lyrics drawer -- simple expand/collapse, no time-sync.
    const lyricsToggle = root.querySelector<HTMLButtonElement>("#cstLyricsToggle");
    const lyricsDrawer = root.querySelector<HTMLElement>("#cstLyricsDrawer");
    const closeDrawer = root.querySelector<HTMLButtonElement>("#cstCloseDrawer");
    lyricsToggle?.addEventListener("click", () => {
      lyricsDrawer?.classList.add("is-open");
      lyricsToggle.classList.add("is-open");
    });
    closeDrawer?.addEventListener("click", () => {
      lyricsDrawer?.classList.remove("is-open");
      lyricsToggle?.classList.remove("is-open");
    });

    // Real Fullscreen API on the app container -- not simulated.
    const app = root.querySelector<HTMLElement>("#cstApp");
    const fsBtn = root.querySelector<HTMLButtonElement>("#cstFsBtn");
    fsBtn?.addEventListener("click", () => {
      if (!document.fullscreenElement) app?.requestFullscreen?.().catch(() => {});
      else document.exitFullscreen?.();
    });

    // Reset to a known state (synthetic-playing, shelf screen, side A,
    // lyrics closed) so re-running init on a soft navigation back to
    // this page doesn't leave stale state from a previous visit. This
    // is a fresh DOM/audio element each time (Astro unmounts on
    // navigation), so there is no real-audio state to carry over.
    setSyntheticPlaying(true);
  }

  // `astro:page-load` fires on initial load too once <ClientRouter />
  // is present (Mission 04) -- relying on it alone, no immediate call,
  // avoids double-binding every listener above.
  document.addEventListener("astro:page-load", initCassettePlayer);
</script>
