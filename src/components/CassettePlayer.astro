---
/**
 * CassettePlayer — Mission 14
 * (missions/MISSION_14_lado-a-lado-b-player.md), fullscreen fix in
 * Mission 15 (missions/MISSION_15_fullscreen-fix.md), real audio for
 * two lado-A tracks added in Mission 16
 * (missions/MISSION_16_real-audio-lado-a.md).
 *
 * Ports reference/lado-a-lado-b-player-flow-reference.html's approved
 * shelf -> cassette -> player flow faithfully:
 *   - Screen 1 (shelf): a grid of closed cassette boxes.
 *   - Screen 2 (cassette): tapping a box opens it — hero graphic, a
 *     lado a / lado b toggle, and that side's tracklist.
 *   - Screen 3 (player): tapping a track opens a full player — video
 *     placeholder, transport controls, scrubber, a real fullscreen
 *     toggle, and an expandable (non-synced) lyrics drawer.
 *
 * Everything for screens 2/3 is pre-rendered server-side (one hero +
 * two tracklists per cassette, all but the first hidden; one lyrics
 * block per track, all but the first hidden) and the client script
 * only toggles `hidden`/`.is-active`, matching the established pattern
 * in ViewMasterShelf.astro (frameStacks/dotsGroups toggled via
 * [hidden] + data-* indices) rather than shipping a parallel JS data
 * blob — the player screen's fields are filled in from the clicked
 * track row's own rendered text/data-*, not a second copy of the data.
 *
 * Screen-transition mechanics (three `.cst-screen`s, only `.is-active`
 * ever toggled, no direction logic) are ported exactly as authored in
 * the reference, including its one quirk: the reference defines a
 * `.screen.behind` CSS rule that its own JS never applies — going
 * "back" slides in from the right, the same direction as going
 * forward, not from the left. That is genuinely what Esteban approved
 * (verified by reading the reference's actual JS, not just its CSS),
 * so it is ported as-is rather than "corrected" into a more
 * conventional back-slides-from-left pattern on my own judgment.
 *
 * PLACEHOLDER DATA (Rule 3): every cassette/track except "Tarde En La
 * Mañana" and "El Ayer" (lado A, first cassette) is still Esteban's
 * approved sample data from the reference file, carried over unchanged
 * — not invented here. Real cassette/track data for the rest is a
 * later mission once recordings exist.
 * TODO: replace the remaining placeholder cassette/track data once
 * Esteban provides more real recordings.
 *
 * Mission 16 real-audio behavior only applies to tracks whose `Track`
 * object (in lado-a-lado-b.astro) carries an `audioSrc`. Every other
 * track is guarded to keep exactly Mission 14/15's visual-only
 * behavior (synthetic play/pause toggle, static scrubber/duration,
 * decorative prev/next, generic placeholder lyrics note) — see
 * `openTrackFromRow`'s two branches below.
 *
 * Deliberately NOT in this mission (see Mission 16's Scope (out)):
 * no cassette-box visual-authenticity redesign, no real video, no
 * time-synced/karaoke lyrics highlighting, no Wake Lock/Web Audio API,
 * no persistent-across-full-page-navigation playback (a known,
 * explicitly-accepted limitation — see MISSION_16_response.md).
 */
interface Track {
  title: string;
  loc: string;
  dur: string;
  /** Mission 16: only "Tarde En La Mañana" and "El Ayer" have this so
   *  far. Every real-audio code path below is guarded on its presence. */
  audioSrc?: string;
  /** Mission 17: only "Tarde En La Mañana" has these so far — the
   *  video's own soundtrack starts 2.8s later than our uploaded audio,
   *  so the muted video is kept seeked/synced to `audio.currentTime +
   *  videoOffset` rather than driving playback itself. Every video
   *  code path below is guarded on `videoId`'s presence. */
  videoId?: string;
  videoOffset?: number;
}

interface Cassette {
  id: string;
  title: string;
  loc: string;
  a: Track[];
  b: Track[];
}

interface Props {
  cassettes: Cassette[];
}

const { cassettes } = Astro.props;

// Same fixed, deterministic cycling order as ViewMasterShelf.astro's
// own DISK_COLORS (Mission 08) — reused here rather than inventing a
// second palette-cycling scheme.
const DISK_COLORS = [
  "--view-master",
  "--retro-pop",
  "--polaroid-sunset",
  "--brown-tape",
  "--stereo-blue",
] as const;

// Player starts in a "playing" state (matching the reference), so the
// play/pause icon is server-rendered as the pause glyph; the client
// script swaps it on click.
const PAUSE_ICON = '<path d="M6 5h4v14H6zM14 5h4v14h-4z"/>';

// Mission 16: real, verbatim lyrics for the two tracks that now have
// real audio, keyed by exact track title (matches lado-a-lado-b.astro's
// data). Blank lines from the mission's source text are kept as `""`
// entries (rendered as `&nbsp;` spacer paragraphs, same convention the
// placeholder lyrics already use) so the stanza breaks survive. No line
// is ever marked active/highlighted here -- these are real, static,
// NOT time-synced text (the mission's own explicit decision), so
// nothing should visually suggest sync exists.
const REAL_LYRICS: Record<string, string[]> = {
  "Tarde En La Mañana": [
    "En la mesa te deje las llaves",
    "Los cigarros se quedaron en la acera",
    "Era ya tarde en la mañana",
    "Y olvide decirte que te amaba",
    "",
    "Conte los pasos mientras me alejaba",
    "Tal vez por las maletas o por tu mirada",
    "Cada paso se me hacía más largo",
    "Cada recuerdo se pasaba a mi conciencia",
    "",
    "Y deje la cama sin tender",
    "Tal vez por la mentira de volver",
    "Y deje mi reflejo en el espejo",
    "No te puedes deshacer de mi",
    "",
    "Yo no quiero despertarte",
    "Quiero que te quedes en mi cama",
    "Que me busques en la Ventana",
    "Que me esperes hasta que vuelva a abrir la puerta",
    "",
    "Tal vez no nos confiamos las verdades",
    "A veces la vida pasa más a prisa",
    "De lo que tardan en pasar nuestras tragedias",
  ],
  "El Ayer": [
    "Fueron quedando vacías las calles de mi ciudad",
    "Donde aún resuenan las fiestas de las que ya no hay mas",
    "",
    "Con la mirada perdida me encontraron otra vez",
    "Yo estaba pensando que siempre es mejor el ayer",
    "",
    "Yo quiero todo de vuelta me lo quitaron sin darme cuenta",
    "Yo quiero vivirlo todo para asegurarme de que si es mejor el ayer",
    "",
    "Se fueron perdiendo cosas canciones de alguna persona o fotos que ya no recuerdo",
    "",
    "Yo quiero todo de vuelta me lo quitaron sin darme cuenta",
    "Yo quiero vivirlo todo para asegurarme de que si es mejor…",
    "",
    "El ayer que ya nunca volverá, ya lo sé, ya nunca volverá",
    "",
    "Yo quiero todo de vuelta me lo quitaron sin darme cuenta",
    "Yo quiero vivirlo todo para asegurarme de que si es mejor…",
  ],
};

// The exact placeholder lyrics Mission 14/15 already shipped (including
// the one demo-highlighted line) — reused verbatim for every track that
// still has no real lyrics, one independent copy per track so each can
// be shown/hidden without affecting any other.
const PLACEHOLDER_LYRICS: { text: string; active?: boolean }[] = [
  { text: "bajo el cielo abierto, cerca de la cima" },
  { text: "grabamos lo que siente esta guitarra", active: true },
  { text: "el viento se lleva la letra a otro lado" },
  { text: "y el cassette guarda lo que nunca dijimos" },
  { text: "" },
  { text: "rebobiná si querés, volvé al principio" },
  { text: "esta cinta no se acaba, solo cambia de lado" },
];

// One stable key per track (cassette index + side + track index),
// shared between each track row (data-lyrics-key) and its matching
// lyrics block below, so the client script can show/hide by simple
// string match -- same [hidden]+data-* pattern as the cassette panels.
function lyricsKeyFor(cassetteIndex: number, side: "a" | "b", trackIndex: number) {
  return `${cassetteIndex}-${side}-${trackIndex}`;
}

const lyricsBlocks = cassettes.flatMap((c, i) => [
  ...c.a.map((t, ti) => ({ key: lyricsKeyFor(i, "a", ti), track: t })),
  ...c.b.map((t, ti) => ({ key: lyricsKeyFor(i, "b", ti), track: t })),
]);
---

<div class="cst">
  <!--
    Mission 15 fix: #cstApp (the actual Fullscreen API target) is kept
    as an unstyled wrapper on purpose. Chrome's fullscreen UA
    stylesheet forces the fullscreen element itself to
    position:fixed/inset:0/width:100%/height:100% in a way no author
    rule (confirmed even at high specificity) can override -- verified
    by reading its computed style while fullscreen (still 1440x900,
    not this file's intended card size). So instead of fighting that,
    #cstApp:fullscreen becomes a full-viewport flex container that
    CENTERS its .cst-card child, which keeps its own intrinsic
    max-width/height sizing untouched -- the classic "letterboxed
    video player" pattern (fullscreen the wrapper, size the content).
  -->
  <div id="cstApp">
    <div class="cst-card">
    <!-- SCREEN 1: shelf of closed cassettes -->
    <div class="cst-screen is-active" id="cstScreenShelf">
      <div class="cst-topbar"><span></span><span>lado a / lado b</span><span></span></div>
      <h2 class="cst-shelf-title">nuestras cintas</h2>
      <p class="cst-shelf-sub">tocá un cassette para ver las canciones</p>
      <div class="cst-grid">
        {
          cassettes.map((c, i) => (
            <button
              type="button"
              class="cst-box"
              data-cassette-index={i}
              style={`--box-color: var(${DISK_COLORS[i % DISK_COLORS.length]})`}
              aria-label={`abrir ${c.title}`}
            >
              <span class="cst-reels">
                <span class="cst-reel" />
                <span class="cst-reel" />
              </span>
              <span class="cst-label">
                <span class="cst-label-title">{c.title}</span>
                <span class="cst-label-sides">lado a / lado b</span>
              </span>
            </button>
          ))
        }
      </div>
    </div>

    <!-- SCREEN 2: open cassette, lado a / lado b -->
    <div class="cst-screen" id="cstScreenCassette">
      <div class="cst-topbar">
        <button type="button" class="cst-back" id="cstBackToShelf" aria-label="volver">‹</button>
        <span id="cstCassetteEyebrow"></span>
        <span></span>
      </div>
      {
        cassettes.map((c, i) => (
          <div class="cst-cassette-panel" data-cassette-index={i} hidden={i !== 0}>
            <div class="cst-hero" style={`--box-color: var(${DISK_COLORS[i % DISK_COLORS.length]})`}>
              <span class="cst-reels cst-reels--lg">
                <span class="cst-reel cst-reel--lg" />
                <span class="cst-reel cst-reel--lg" />
              </span>
              <div class="cst-hero-label">
                <h2>{c.title}</h2>
                <div class="cst-hero-loc">{c.loc}</div>
              </div>
            </div>
            <div class="cst-side-toggle">
              <button type="button" class="cst-side-btn is-active" data-side="a">
                lado a
              </button>
              <button type="button" class="cst-side-btn" data-side="b">
                lado b
              </button>
            </div>
            <div class="cst-tracklist" data-side="a">
              {c.a.map((t, ti) => (
                <button
                  type="button"
                  class="cst-track-row"
                  data-title={t.title}
                  data-loc={t.loc}
                  data-dur={t.dur}
                  data-audio-src={t.audioSrc}
                  data-video-id={t.videoId}
                  data-video-offset={t.videoOffset}
                  data-cassette-title={c.title}
                  data-lyrics-key={lyricsKeyFor(i, "a", ti)}
                >
                  <span class="cst-track-num">{ti + 1}</span>
                  <span class="cst-track-meta">
                    <span class="cst-track-title">{t.title}</span>
                    <span class="cst-track-loc">{t.loc}</span>
                  </span>
                  <span class="cst-track-dur">{t.dur}</span>
                  <span class="cst-track-play" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </span>
                </button>
              ))}
            </div>
            <div class="cst-tracklist" data-side="b" hidden>
              {c.b.map((t, ti) => (
                <button
                  type="button"
                  class="cst-track-row"
                  data-title={t.title}
                  data-loc={t.loc}
                  data-dur={t.dur}
                  data-audio-src={t.audioSrc}
                  data-video-id={t.videoId}
                  data-video-offset={t.videoOffset}
                  data-cassette-title={c.title}
                  data-lyrics-key={lyricsKeyFor(i, "b", ti)}
                >
                  <span class="cst-track-num">{ti + 1}</span>
                  <span class="cst-track-meta">
                    <span class="cst-track-title">{t.title}</span>
                    <span class="cst-track-loc">{t.loc}</span>
                  </span>
                  <span class="cst-track-dur">{t.dur}</span>
                  <span class="cst-track-play" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </span>
                </button>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <!-- SCREEN 3: player -->
    <div class="cst-screen" id="cstScreenPlayer">
      <div class="cst-topbar">
        <button type="button" class="cst-back" id="cstBackToCassette" aria-label="volver">‹</button>
        <span>reproduciendo desde las cintas</span>
        <span></span>
      </div>
      <div class="cst-video-wrap" id="cstVideoWrap">
        <div class="cst-scanline"></div>
        <!-- Mission 17: a single reused YouTube player host (same
             "one reused instance, not recreated per click" pattern as
             Mission 16's <audio> element) -- hidden/empty until a
             track with a videoId is opened. Every other track keeps
             showing the placeholder scene below exactly as before. -->
        <div class="cst-yt-host" id="cstYtHost" hidden></div>
        <div class="cst-placeholder-scene" id="cstPlaceholderScene">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
            <path d="M3 8a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
            <path d="m21 8-5 3 5 3z" />
          </svg>
          <span id="cstVideoPlaceholderLabel">video (placeholder)</span>
        </div>
        <div class="cst-rec-badge"><span class="cst-rec-dot"></span> en vivo · locación</div>
        <button class="cst-fullscreen-btn" id="cstFsBtn" aria-label="pantalla completa">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M8 21H5a2 2 0 0 1-2-2v-3M16 21h3a2 2 0 0 0 2-2v-3" />
          </svg>
        </button>
        <div class="cst-tap-overlay" id="cstTapOverlay">
          <div class="cst-big-play">
            <svg viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z" />
            </svg>
          </div>
        </div>
      </div>
      <div class="cst-track-info">
        <div class="cst-eyebrow">audiocassettes</div>
        <h2 id="cstPlayerTitle">—</h2>
        <div class="cst-player-loc" id="cstPlayerLoc">—</div>
      </div>
      <div class="cst-scrub-wrap">
        <div class="cst-scrub-bar" id="cstScrubBar">
          <div class="cst-scrub-fill"></div>
        </div>
        <div class="cst-time-row">
          <span id="cstPlayerElapsed">1:12</span>
          <span id="cstPlayerDur">3:41</span>
        </div>
      </div>
      <div class="cst-controls">
        <button type="button" class="cst-secondary" id="cstPrevBtn" aria-label="anterior">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M6 6h2v12H6zM20 6v12l-8.5-6z" />
          </svg>
        </button>
        <button type="button" class="cst-play-pause" id="cstPlayBtn" aria-label="pausa">
          <svg viewBox="0 0 24 24" fill="currentColor" id="cstPlayIcon" set:html={PAUSE_ICON} />
        </button>
        <button type="button" class="cst-secondary" id="cstNextBtn" aria-label="siguiente">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M16 6h2v12h-2zM4 6v12l8.5-6z" />
          </svg>
        </button>
      </div>
      <button type="button" class="cst-lyrics-toggle" id="cstLyricsToggle">
        <span>letras</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="m6 9 6 6 6-6" />
        </svg>
      </button>
      <div class="cst-lyrics-drawer" id="cstLyricsDrawer">
        <div class="cst-drawer-handle"></div>
        <div class="cst-drawer-head">
          <h3 id="cstLyricsDrawerTitle">letras</h3>
          <button type="button" id="cstCloseDrawer" aria-label="cerrar">✕</button>
        </div>
        {
          lyricsBlocks.map(({ key, track }, idx) => {
            const real = REAL_LYRICS[track.title];
            return (
              <div class="cst-lyrics-block" data-lyrics-key={key} hidden={idx !== 0}>
                <div class="cst-lyrics-body">
                  {real
                    ? real.map((line) => (
                        <p class="cst-lyric-line">{line === "" ? " " : line}</p>
                      ))
                    : PLACEHOLDER_LYRICS.map((l) => (
                        <p class:list={["cst-lyric-line", { "is-active": l.active }]}>
                          {l.text === "" ? " " : l.text}
                        </p>
                      ))}
                </div>
                {!real && (
                  <p class="cst-lyrics-note">
                    Letra de ejemplo — panel simple, sin sincronización por ahora.
                  </p>
                )}
              </div>
            );
          })
        }
      </div>
    </div>
    </div>
  </div>
  <!-- Mission 16: a single real <audio> element, reused across track
       opens (never recreated per click) -- no native controls, the
       custom UI above drives it entirely. -->
  <audio id="cstAudio" preload="none"></audio>
</div>

<style>
  /* Every color below traces to an established token or the black/white
     neutral precedents already used elsewhere in this codebase
     (global.css's own placeholder-block already mixes `white`; Missions
     08/10/12 already established `black` via color-mix()) — the
     reference's own extra `--ink` token and raw hex values (used for
     the video-wrap/lyrics-drawer's dark gradients) are replaced with
     color-mix() derivations from --brown-tape + black, see
     MISSION_14_response.md for the exact correspondence. */
  .cst {
    margin-top: var(--space-5);
  }

  /* Mission 15 fix, corrected approach: an EARLIER version of this fix
     tried an author `#cstApp:fullscreen { width; height; margin: auto }`
     rule directly on the fullscreen target itself, on the assumption
     that author normal-importance beats UA normal-importance (the same
     cascade rule behind this project's established `[hidden]` fix).
     That assumption was WRONG for this specific case, confirmed by
     reading `getComputedStyle(app)` while actually fullscreen: width/
     height/position stayed exactly at the UA's forced 100%/100%/fixed
     values (1440x900 at that test size) -- Chrome's fullscreen UA
     stylesheet wins here regardless (verified, not guessed twice).
     So `#cstApp` (the actual .requestFullscreen() target) is now kept
     as a bare, unstyled wrapper -- all the card's own sizing/
     background/shadow live on the new `.cst-card` child instead, and
     `#cstApp:fullscreen` only turns the WRAPPER into a full-viewport
     flex container that centers that untouched, still-intrinsically-
     sized card -- the same pattern real letterboxed video players use
     (fullscreen the wrapper, size the content), which cannot be
     defeated by the UA forcibly maximizing the wrapper itself, because
     the wrapper filling the screen is exactly what we now want. */
  .cst-card {
    position: relative;
    width: 100%;
    max-width: 26rem;
    margin: 0 auto;
    height: min(44rem, 82vh);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--brown-tape) 55%, black) 0%,
      color-mix(in srgb, var(--brown-tape) 25%, black) 55%
    );
    color: var(--vintage-sky);
    font-family: var(--font-body);
    box-shadow: 0 16px 40px color-mix(in srgb, black 45%, transparent);
  }

  #cstApp:fullscreen {
    display: flex;
    align-items: center;
    justify-content: center;
    /* Letterbox fill behind the centered card -- the same dark
       brown-tape/black derivation already used for this file's own
       video-wrap gradient, not a new color. */
    background: color-mix(in srgb, var(--brown-tape) 15%, black 85%);
  }

  /* ::backdrop as a fallback/defense-in-depth for the moment before
     #cstApp's own fullscreen background paints -- same color, so
     there's no visible mismatch either way. */
  #cstApp::backdrop {
    background: color-mix(in srgb, var(--brown-tape) 15%, black 85%);
  }

  .cst-screen {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.32s cubic-bezier(0.2, 0.8, 0.3, 1);
    overflow-y: auto;
  }

  .cst-screen.is-active {
    transform: translateX(0);
  }

  /* Ported from the reference as-authored: this rule exists in the
     reference's own CSS but its JS never applies it (verified by
     reading the script, not assumed) -- back navigation slides in
     from the right too, same as forward. Kept inert here for the same
     reason: faithful port, not a corrected guess. */
  .cst-screen.is-behind {
    transform: translateX(-100%);
  }

  .cst-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem 1.1rem 0.4rem;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: lowercase;
    color: color-mix(in srgb, var(--stereo-blue) 55%, var(--vintage-sky));
    flex-shrink: 0;
  }

  .cst-back {
    background: none;
    border: none;
    color: var(--vintage-sky);
    font-size: 1.3rem;
    cursor: pointer;
    opacity: 0.85;
    padding: 0.25rem;
  }

  /* ===== SCREEN 1: shelf ===== */
  .cst-shelf-title {
    padding: 0 1.3rem;
    margin: 0.3rem 0 0.2rem;
    font-size: 1.1rem;
  }

  .cst-shelf-sub {
    padding: 0 1.3rem;
    margin: 0 0 1rem;
    font-size: 0.75rem;
    opacity: 0.6;
  }

  .cst-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    padding: 0 1.3rem 1.5rem;
  }

  .cst-box {
    position: relative;
    /* min-width: 0 overrides a real CSS-spec gotcha found during this
       mission's own narrow-viewport verification (not present in the
       reference's fixed 420px demo frame): a grid item with
       aspect-ratio set gets its automatic minimum width transferred
       from its flex-column content's minimum height, which was
       inflating each track past half the grid's real width and
       causing horizontal overflow at 320/375px. This lets the item
       shrink to its actual grid track instead. */
    min-width: 0;
    aspect-ratio: 3 / 2;
    border-radius: 0.5rem;
    padding: 0.55rem;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow:
      0 6px 14px color-mix(in srgb, black 40%, transparent),
      inset 0 0 0 1px color-mix(in srgb, black 25%, transparent);
    transition: transform 0.15s;
    background: var(--box-color);
    border: none;
    font-family: inherit;
  }

  .cst-box:active {
    transform: scale(0.96);
  }

  .cst-reels {
    display: flex;
    justify-content: space-evenly;
    align-items: center;
