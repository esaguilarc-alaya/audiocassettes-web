---
/**
 * Four-color stripe device.
 *
 * Confirmed against reference/Audiocassettes_Manual de Identidad.pdf
 * (p.21, "elementos complementarios") and reference/home-mockup-reference.html
 * — both specify this exact order: brown-tape, polaroid-sunset, view-master,
 * retro-pop. (An earlier draft of this component guessed a different four
 * before the manual was available; that guess is superseded.)
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["stripe", className]} role="presentation" aria-hidden="true">
  <span class="stripe__band" style="background: var(--brown-tape);"></span>
  <span class="stripe__band" style="background: var(--polaroid-sunset);"></span>
  <span class="stripe__band" style="background: var(--view-master);"></span>
  <span class="stripe__band" style="background: var(--retro-pop);"></span>
</div>

<style>
  .stripe {
    display: flex;
    width: 100%;
    height: 5px;
  }

  .stripe__band {
    flex: 1 1 0;
  }
</style>
