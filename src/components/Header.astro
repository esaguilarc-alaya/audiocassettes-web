---
import Stripe from "./Stripe.astro";
import Isologo from "./Isologo.astro";

const navLinks = [
  { href: "/lado-a-lado-b", label: "lado a / lado b" },
  { href: "/las-cintas", label: "las cintas" },
  { href: "/notas-de-cinta", label: "el librito" },
  { href: "/el-estuche", label: "el estuche" },
  { href: "/sintoniza", label: "sintoniza" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="site-header" transition:name="site-header">
  <Stripe />
  <div class="site-header__row">
    <a href="/" class="wordmark" aria-label="audiocassettes — inicio">
      <Isologo />
    </a>
    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="primary-nav-list"
      aria-label="abrir menú"
    >
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
    </button>
    <nav aria-label="secciones principales">
      <ul id="primary-nav-list" hidden>
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={currentPath === link.href ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
    max-width: 68.75rem;
    margin: 0 auto;
    padding: var(--space-4) var(--space-4) 0;
  }

  .wordmark {
    color: var(--brown-tape);
    font-size: 1.375rem;
    font-weight: 700;
    text-decoration: none;
  }

  .nav-toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    background: transparent;
    border: 2px solid var(--brown-tape);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .nav-toggle__bar {
    display: block;
    width: 1.375rem;
    height: 2px;
    background: var(--brown-tape);
    transition:
      transform 150ms ease-out,
      opacity 150ms ease-out;
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle__bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-toggle[aria-expanded="true"] .nav-toggle__bar:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle[aria-expanded="true"] .nav-toggle__bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 1.6rem;
    margin: 0;
    padding: 0;
  }

  nav a {
    color: var(--brown-tape);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    opacity: 0.85;
    padding-bottom: 3px;
    border-bottom: 2px solid transparent;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    opacity: 1;
    border-bottom-color: var(--view-master);
  }

  /* Below this width, the five-link row no longer fits comfortably —
     collapse it behind a disclosure toggle instead of relying on
     flex-wrap alone (see missions/MISSION_03_mobile-responsive.md). */
  @media (max-width: 50rem) {
    .nav-toggle {
      display: flex;
    }

    nav {
      flex-basis: 100%;
    }

    nav ul[hidden] {
      display: none;
    }

    nav ul {
      flex-direction: column;
      gap: 0;
      width: 100%;
      padding-top: var(--space-2);
    }

    nav li {
      width: 100%;
    }

    nav a {
      display: block;
      padding: var(--space-3) 0;
      font-size: 1rem;
      border-bottom: 1px solid color-mix(in srgb, var(--brown-tape) 15%, transparent);
    }
  }
</style>

<script>
  function initNavToggle() {
    const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
    const list = document.getElementById("primary-nav-list");
    if (!toggle || !list) return;

    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!isOpen));
      toggle.setAttribute("aria-label", isOpen ? "abrir menú" : "cerrar menú");
      if (isOpen) {
        list.setAttribute("hidden", "");
      } else {
        list.removeAttribute("hidden");
      }
    });
  }

  // `astro:page-load` fires once after the initial page load AND after
  // every subsequent View Transitions swap (Mission 04 enabled
  // <ClientRouter /> in BaseLayout.astro) — relying on it alone (rather
  // than also calling initNavToggle() immediately) avoids double-binding
  // a click listener to the same button on first load, which silently
  // cancelled the toggle out (open-then-immediately-closed) once the
  // router started dispatching that event on the initial load too.
  document.addEventListener("astro:page-load", initNavToggle);
</script>
