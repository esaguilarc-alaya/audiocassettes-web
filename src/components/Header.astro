---
import Stripe from "./Stripe.astro";
import Isologo from "./Isologo.astro";

const navLinks = [
  { href: "/lado-a-lado-b", label: "lado a / lado b" },
  { href: "/las-cintas", label: "las cintas" },
  { href: "/notas-de-cinta", label: "notas de cinta" },
  { href: "/el-estuche", label: "el estuche" },
  { href: "/sintoniza", label: "sintoniza" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="site-header">
  <Stripe />
  <div class="site-header__row">
    <a href="/" class="wordmark" aria-label="audiocassettes — inicio">
      <Isologo />
    </a>
    <nav aria-label="secciones principales">
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={currentPath === link.href ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
    max-width: 68.75rem;
    margin: 0 auto;
    padding: var(--space-4) var(--space-4) 0;
  }

  .wordmark {
    color: var(--brown-tape);
    font-size: 1.375rem;
    font-weight: 700;
    text-decoration: none;
  }

  nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 1.6rem;
    margin: 0;
    padding: 0;
  }

  nav a {
    color: var(--brown-tape);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    opacity: 0.85;
    padding-bottom: 3px;
    border-bottom: 2px solid transparent;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    opacity: 1;
    border-bottom-color: var(--view-master);
  }
</style>
