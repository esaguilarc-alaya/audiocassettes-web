---
/**
 * "notas de cinta" teaser block — home page.
 */
---

<section class="notas-teaser">
  <h2>notas de cinta</h2>
  <p>[ descripción real de la sección de notas/blog de la banda aquí ]</p>
  <div class="placeholder-block">
    [ vista previa real de una entrada aquí ]
  </div>
  <a class="notas-teaser__link" href="/notas-de-cinta">leer notas de cinta</a>
</section>

<style>
  .notas-teaser {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-5) var(--space-4);
  }

  .notas-teaser h2 {
    color: var(--retro-pop);
    font-size: 2rem;
    margin-bottom: var(--space-2);
  }

  .notas-teaser > .placeholder-block {
    margin-block: var(--space-4);
  }

  .notas-teaser__link {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 600;
    text-decoration: none;
    color: var(--retro-pop);
    border-bottom: 2px solid var(--retro-pop);
  }
</style>
