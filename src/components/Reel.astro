---
/**
 * Reel — a View-Master-style interaction for one "cinta" (one
 * location/session). Mission 02 scope: missions/MISSION_02_hero-accent-reel.md
 *
 * A reel holds an ordered sequence of frames that may mix video, photo,
 * old-band-photo, and band-art types within the same reel. All frame
 * media in this mission is placeholder-only (Standing Rule 3) — frames
 * render obviously-fake placeholder blocks, never real assets.
 *
 * Interaction (vanilla JS, no framework — none is installed in this
 * project; see package.json):
 *   - Lever click: advance to next frame, slide-and-rotate transition in.
 *   - Click left half of the viewer: go back one frame, same transition
 *     reversed.
 *   - Frame-counter dots: reflect current position (display only, not an
 *     interactive jump control — not specified by the mission, so not
 *     built, per Standing Rule 4).
 *   - Video frames show a play badge; clicking the badge opens a
 *     branded <dialog> modal with a YouTube iframe pointed at a
 *     placeholder video ID.
 */
interface Frame {
  type: "video" | "photo" | "band-photo" | "art";
  label: string;
  /** Required when type === "video"; an obviously-fake placeholder ID. */
  videoId?: string;
}

interface Props {
  /** Unique per-reel id, used to namespace the modal's DOM id. */
  id: string;
  location: string;
  frames: Frame[];
}

const { id, location, frames } = Astro.props;

const frameCopy: Record<Frame["type"], string> = {
  video: "[ video real aquí — placeholder ]",
  photo: "[ foto real aquí — placeholder ]",
  "band-photo": "[ foto de banda, de época — placeholder ]",
  art: "[ arte de banda — placeholder ]",
};
---

<div class="reel" data-reel={id}>
  <div class="reel-body">
    <div class="reel-viewer" role="group" aria-label={`cinta: ${location}`}>
      <div class="reel-frame-stack">
        {
          frames.map((frame, i) => (
            <figure
              class:list={["reel-frame", { "is-active": i === 0 }]}
              data-index={i}
              data-frame-type={frame.type}
            >
              <div class="frame-media placeholder-block">
                <span>{frameCopy[frame.type]}</span>
              </div>
              {frame.type === "video" && (
                <button
                  type="button"
                  class="play-badge"
                  aria-label={`reproducir (placeholder): ${frame.label}`}
                  aria-haspopup="dialog"
                  aria-controls={`${id}-modal`}
                  data-video-id={frame.videoId}
                >
                  &#9658;
                </button>
              )}
              <figcaption>{frame.label}</figcaption>
            </figure>
          ))
        }
      </div>
      <span class="viewer-back-hint" aria-hidden="true">&#8249;</span>
    </div>

    <button type="button" class="reel-lever" aria-label="avanzar cinta">
      <span class="reel-lever__grip"></span>
    </button>
  </div>

  <div class="reel-footer">
    <div class="reel-location">{location}</div>
    <div class="reel-dots" role="presentation">
      {
        frames.map((_, i) => (
          <span class:list={["reel-dot", { "is-active": i === 0 }]} />
        ))
      }
    </div>
  </div>

  <dialog id={`${id}-modal`} class="reel-modal">
    <div class="reel-modal__frame">
      <button type="button" class="reel-modal__close" aria-label="cerrar video">
        &#10005;
      </button>
      <div class="reel-modal__embed">
        <iframe
          src=""
          title="video placeholder — audiocassettes"
          loading="lazy"
          allow="encrypted-media"
        />
      </div>
      <p class="reel-modal__note">
        [ video no funcional — ID de YouTube de relleno, sin contenido real
        de la banda todavía ]
      </p>
    </div>
  </dialog>
</div>

<style>
  .reel {
    max-width: 26rem;
  }

  .reel-body {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .reel-viewer {
    position: relative;
    flex: 1;
    aspect-ratio: 4 / 3;
    background: var(--brown-tape);
    border-radius: var(--radius-md);
    overflow: hidden;
    cursor: pointer;
    box-shadow: inset 0 0 0 4px var(--vintage-sky);
  }

  .reel-frame-stack {
    position: absolute;
    inset: 0;
  }

  .reel-frame {
    position: absolute;
    inset: 0;
    margin: 0;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3);
    text-align: center;
    background: var(--vintage-sky);
  }

  .reel-frame.is-active {
    display: flex;
  }

  .reel-frame .frame-media {
    width: 100%;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
  }

  .reel-frame figcaption {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.75rem;
    color: var(--brown-tape);
  }

  @keyframes reel-frame-in-forward {
    from {
      transform: translateX(60%) rotate(12deg);
      opacity: 0;
    }
    to {
      transform: translateX(0) rotate(0deg);
      opacity: 1;
    }
  }

  @keyframes reel-frame-in-back {
    from {
      transform: translateX(-60%) rotate(-12deg);
      opacity: 0;
    }
    to {
      transform: translateX(0) rotate(0deg);
      opacity: 1;
    }
  }

  .reel-frame.frame-enter-forward {
    animation: reel-frame-in-forward 380ms ease-out;
  }

  .reel-frame.frame-enter-back {
    animation: reel-frame-in-back 380ms ease-out;
  }

  .play-badge {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 2px solid var(--vintage-sky);
    background: var(--view-master);
    color: var(--vintage-sky);
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
  }

  .play-badge:hover {
    background: var(--brown-tape);
  }

  .viewer-back-hint {
    position: absolute;
    top: 50%;
    left: 0.5rem;
    transform: translateY(-50%);
    color: var(--vintage-sky);
    opacity: 0.55;
    font-size: 1.5rem;
    pointer-events: none;
  }

  .reel-lever {
    flex: 0 0 auto;
    width: 2.75rem; /* >= 44px, the minimum comfortable touch target */
    height: 6.5rem;
    border-radius: var(--radius-sm);
    border: 2px solid var(--brown-tape);
    background: var(--retro-pop);
    cursor: pointer;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 0.375rem;
    transition: transform 120ms ease-out;
  }

  .reel-lever:hover {
    background: var(--view-master);
  }

  .reel-lever:active {
    transform: translateY(0.375rem);
  }

  .reel-lever__grip {
    width: 1.125rem;
    height: 1.125rem;
    border-radius: 50%;
    background: var(--vintage-sky);
  }

  .reel-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .reel-location {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .reel-dots {
    display: flex;
    gap: 0.375rem;
  }

  .reel-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--brown-tape);
    opacity: 0.3;
  }

  .reel-dot.is-active {
    opacity: 1;
    background: var(--retro-pop);
  }

  .reel-modal {
    padding: 0;
    border: none;
    border-radius: var(--radius-md);
    max-width: 32rem;
    width: 90vw;
  }

  .reel-modal::backdrop {
    background: rgba(0, 0, 0, 0.6);
  }

  .reel-modal__frame {
    background: var(--vintage-sky);
    border: 0.5rem solid var(--brown-tape);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    position: relative;
  }

  .reel-modal__close {
    position: absolute;
    top: -0.75rem;
    right: -0.75rem;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--view-master);
    color: var(--vintage-sky);
    border: 2px solid var(--vintage-sky);
    font-size: 1rem;
    cursor: pointer;
  }

  .reel-modal__embed {
    aspect-ratio: 16 / 9;
    background: black;
  }

  .reel-modal__embed iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .reel-modal__note {
    margin: var(--space-2) 0 0;
    font-size: 0.75rem;
    color: var(--brown-tape);
    opacity: 0.75;
    text-align: center;
  }
</style>

<script>
  function initReels() {
    document.querySelectorAll<HTMLElement>(".reel").forEach((reelEl) => {
      const frames = Array.from(
        reelEl.querySelectorAll<HTMLElement>(".reel-frame"),
      );
      const dots = Array.from(
        reelEl.querySelectorAll<HTMLElement>(".reel-dot"),
      );
      const viewer = reelEl.querySelector<HTMLElement>(".reel-viewer");
      const lever = reelEl.querySelector<HTMLButtonElement>(".reel-lever");
      const modal = reelEl.querySelector<HTMLDialogElement>(".reel-modal");
      const modalIframe = modal?.querySelector("iframe");
      const modalClose = modal?.querySelector<HTMLButtonElement>(
        ".reel-modal__close",
      );

      if (!frames.length || !viewer) return;

      let current = frames.findIndex((f) => f.classList.contains("is-active"));
      if (current < 0) current = 0;

      function render(direction: "forward" | "back") {
        frames.forEach((f, i) => f.classList.toggle("is-active", i === current));
        dots.forEach((d, i) => d.classList.toggle("is-active", i === current));

        const activeFrame = frames[current];
        activeFrame.classList.remove("frame-enter-forward", "frame-enter-back");
        // Force reflow so the animation restarts even when re-entering
        // the same frame element (e.g. the reel wraps around).
        void activeFrame.offsetWidth;
        activeFrame.classList.add(
          direction === "back" ? "frame-enter-back" : "frame-enter-forward",
        );
      }

      function goTo(index: number, direction: "forward" | "back") {
        current = (index + frames.length) % frames.length;
        render(direction);
      }

      lever?.addEventListener("click", () => goTo(current + 1, "forward"));

      viewer.addEventListener("click", (event) => {
        if ((event.target as HTMLElement).closest(".play-badge")) return;
        const rect = viewer.getBoundingClientRect();
        const clickX = (event as MouseEvent).clientX - rect.left;
        if (clickX < rect.width / 2) {
          goTo(current - 1, "back");
        }
      });

      reelEl.querySelectorAll<HTMLButtonElement>(".play-badge").forEach((badge) => {
        badge.addEventListener("click", (event) => {
          event.stopPropagation();
          const videoId = badge.dataset.videoId;
          if (modal && modalIframe && videoId) {
            modalIframe.src = `https://www.youtube.com/embed/${videoId}`;
            modal.showModal();
          }
        });
      });

      function closeModal() {
        if (modalIframe) modalIframe.src = "";
        modal?.close();
      }

      modalClose?.addEventListener("click", closeModal);
      modal?.addEventListener("click", (event) => {
        if (event.target === modal) closeModal();
      });
      modal?.addEventListener("close", () => {
        if (modalIframe) modalIframe.src = "";
      });
    });
  }

  // See Header.astro's identical comment: `astro:page-load` alone
  // covers both the initial load and every soft-navigation swap now
  // that <ClientRouter /> is enabled (Mission 04) — an additional
  // immediate call here would double-bind every reel's listeners
  // (each play-badge would get two `showModal()` calls, the second
  // throwing on an already-open dialog).
  document.addEventListener("astro:page-load", initReels);
</script>
