---
import EmailSignupForm from "./EmailSignupForm.astro";
---

<section class="sintoniza-teaser">
  <h2>sintoniza</h2>
  <p>
    entérate de novedades de la banda. [ copy real de la sección aquí —
    encuesta/votación planeada para una misión futura ]
  </p>
  <EmailSignupForm />
</section>

<style>
  .sintoniza-teaser {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-5) var(--space-4);
  }

  .sintoniza-teaser h2 {
    color: var(--view-master);
    font-size: 2rem;
    margin-bottom: var(--space-2);
  }

  .sintoniza-teaser p {
    max-width: 40rem;
    margin-bottom: var(--space-4);
  }
</style>
