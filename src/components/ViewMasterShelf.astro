---
/**
 * ViewMasterShelf — Mission 08
 * (missions/MISSION_08_las-cintas-viewmaster.md), disc/viewer visuals
 * replaced in Mission 10
 * (missions/MISSION_10_viewmaster-visual-refinement.md).
 *
 * Replaces Mission 02/03's always-open `Reel` cards with a two-level
 * interaction: a shelf of View-Master-style disks (one per session),
 * and a single shared viewer dialog you zoom into by clicking a disk.
 * The shelf→viewer→full-open→close flow, looping, dots, and left-
 * half-back gesture are all Mission 08's, unchanged by this mission.
 *
 * Mission 08's own disc (a plain circle + single colored hub, a
 * sprocket-hole radial-line ring) and viewer (a flat rectangular
 * body) were both explicitly flagged by Esteban as not reading like a
 * real View-Master toy. Mission 10 replaces just those visuals,
 * porting reference/las-cintas-viewmaster-look-reference.html
 * faithfully this time (unlike Mission 08's flow-only reference, this
 * one's visuals ARE the settled target):
 *   - Disc: a ring of 7 small "photo window" swatches, each rotated
 *     by its own placement angle with no counter-rotation (a real
 *     fan/pinwheel, not all upright) — see WINDOW_COUNT/windowAngles
 *     below — using the disc's one assigned DISK_COLORS entry for all
 *     7 windows (color moved here from the old single hub). Small rim
 *     notches between the windows, plain black — no radiating lines.
 *     A center hub with plain (non-arced) text: an orientation mark,
 *     a small hole, the disc's title, and its frame count.
 *   - Viewer: the classic two-piece View-Master silhouette — a
 *     --view-master eyecup housing (twin plain-black eyecups) above a
 *     --brown-tape lower body, matching the reference's own two-tone
 *     split. (The mission text's own color note says Mission 08 used
 *     --view-master for the viewer body, but Mission 08 actually used
 *     --brown-tape for the whole flat body — this mission follows the
 *     reference file's explicit red-top/brown-bottom split, which is
 *     the settled visual target, over that historical mis-note;
 *     flagged here and in the response file.) The lever moved from
 *     centered-below-the-eyepiece to mounted on the body's right
 *     edge, angled, and now visibly presses/rotates down on click
 *     before springing back.
 *   - The oval eyepiece itself (shape, plain-black tunnel) is
 *     unchanged from Mission 08 — not part of this mission's scope.
 *
 * Interaction mechanics (lever-advances, left-half-back, frame-
 * counter dots, looping, opening a frame full-size, Escape/✕-closes-
 * to-shelf) are all exactly Mission 08's unchanged logic — this
 * mission only restyles the disc, the viewer chrome, and the lever's
 * position/shape/press animation, not its click handler or what it
 * does.
 */
interface Frame {
  type: "video" | "photo" | "band-photo" | "art";
  label: string;
  /** Required when type === "video"; an obviously-fake placeholder ID. */
  videoId?: string;
}

interface Disk {
  id: string;
  location: string;
  frames: Frame[];
}

interface Props {
  disks: Disk[];
}

const { disks } = Astro.props;

const frameCopy: Record<Frame["type"], string> = {
  video: "[ video real aquí — placeholder ]",
  photo: "[ foto real aquí — placeholder ]",
  "band-photo": "[ foto de banda, de época — placeholder ]",
  art: "[ arte de banda — placeholder ]",
};

// Fixed, deterministic cycling order — Mission 08's own scope names
// this exact sequence; not an invented or approximated palette.
const DISK_COLORS = [
  "--view-master",
  "--retro-pop",
  "--polaroid-sunset",
  "--brown-tape",
  "--stereo-blue",
] as const;

// Mission 10: a fixed ring of 7 decorative "photo window" swatches per
// disc, independent of that disk's actual frame count (matching the
// approved reference, which shows 7 windows on both a 4-frame and a
// 3-frame disk) — rotated by its own position angle with NO counter-
// rotation, which is what makes them fan around the ring instead of
// all staying upright, same as a real disc.
const WINDOW_COUNT = 7;
const windowAngles = Array.from(
  { length: WINDOW_COUNT },
  (_, i) => (360 / WINDOW_COUNT) * i,
);
// Rim notches sit BETWEEN the windows, offset by half a step.
const notchAngles = Array.from(
  { length: WINDOW_COUNT },
  (_, i) => (360 / WINDOW_COUNT) * i + 360 / WINDOW_COUNT / 2,
);
---

<div class="vm">
  <div class="vm-shelf" id="vmShelf">
    {
      disks.map((disk, i) => (
        <button
          type="button"
          class="vm-disk-slot"
          data-disk-index={i}
          data-location={disk.location}
          aria-haspopup="dialog"
        >
          <span
            class="vm-disk"
            style={`--disk-color: var(${DISK_COLORS[i % DISK_COLORS.length]})`}
          >
            {
              windowAngles.map((angle) => (
                <span class="vm-window" style={`--angle: ${angle}deg`} />
              ))
            }
            {
              notchAngles.map((angle) => (
                <span class="vm-notch" aria-hidden="true" style={`--angle: ${angle}deg`} />
              ))
            }
            <span class="vm-center-hub">
              <span class="vm-up-mark" aria-hidden="true">
                &#9650;
              </span>
              <span class="vm-hole" aria-hidden="true" />
              <span class="vm-disc-title">{disk.location}</span>
              <span class="vm-disc-sub">{disk.frames.length} recuerdos</span>
            </span>
          </span>
        </button>
      ))
    }
  </div>

  <dialog class="vm-viewer" id="vmViewer" aria-label="visor de cinta">
    <div class="vm-viewer__body">
      <div class="vm-viewer__top">
        <span class="vm-viewer__title" id="vmViewerTitle" />
        <button
          type="button"
          class="vm-viewer__close"
          aria-label="cerrar visor, volver al estante"
        >
          &#10005;
        </button>
      </div>

      <div class="vm-toy">
        <div class="vm-eyecup-housing" aria-hidden="true">
          <span class="vm-eyecup" />
          <span class="vm-eyecup" />
        </div>
        <div class="vm-lower-body">
          <div class="vm-eyepiece" id="vmEyepiece">
            {
              disks.map((disk, di) => (
                <div class="vm-frame-stack" data-disk-index={di} hidden>
                  {disk.frames.map((frame, fi) => (
                    <figure
                      class:list={["vm-frame", { "is-active": fi === 0 }]}
                      data-index={fi}
                      data-frame-type={frame.type}
                      data-video-id={frame.videoId}
                    >
                      <div class="frame-media placeholder-block">
                        <span>{frameCopy[frame.type]}</span>
                      </div>
                      {frame.type === "video" && (
                        <span class="vm-play-badge" aria-hidden="true">
                          &#9658;
                        </span>
                      )}
                      <figcaption>{frame.label}</figcaption>
                    </figure>
                  ))}
                </div>
              ))
            }
            <span class="vm-back-hint" aria-hidden="true">
              &#8249;
            </span>
          </div>

          <div class="vm-lever-mount">
            <button type="button" class="vm-lever" aria-label="avanzar cinta" />
          </div>
        </div>
      </div>

      <div class="vm-dots-wrap">
        {
          disks.map((disk, di) => (
            <div class="vm-dots" data-disk-index={di} hidden role="presentation">
              {disk.frames.map((_, fi) => (
                <span class:list={["vm-dot", { "is-active": fi === 0 }]} />
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </dialog>

  <dialog class="vm-modal" id="vmVideoModal">
    <div class="vm-modal__frame">
      <button type="button" class="vm-modal__close" aria-label="cerrar video">
        &#10005;
      </button>
      <div class="vm-modal__embed">
        <iframe
          id="vmVideoIframe"
          src=""
          title="video placeholder — audiocassettes"
          loading="lazy"
          allow="encrypted-media"
        />
      </div>
      <p class="vm-modal__note">
        [ video no funcional — ID de YouTube de relleno, sin contenido real
        de la banda todavía ]
      </p>
    </div>
  </dialog>

  <dialog class="vm-modal" id="vmPhotoModal">
    <div class="vm-modal__frame">
      <button type="button" class="vm-modal__close" aria-label="cerrar foto">
        &#10005;
      </button>
      <div class="vm-modal__photo placeholder-block" id="vmPhotoBody">
        <span id="vmPhotoText" />
      </div>
    </div>
  </dialog>
</div>

<style>
  /* -------------------- Shelf -------------------- */
  .vm-shelf {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(11rem, 100%), 1fr));
    gap: var(--space-5);
    justify-items: center;
  }

  .vm-disk-slot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    background: none;
    border: none;
    font: inherit;
    cursor: pointer;
    padding: var(--space-2);
    max-width: 11rem;
  }

  .vm-disk {
    position: relative;
    width: 9rem;
    height: 9rem;
    border-radius: 50%;
    background: var(--vintage-sky);
    border: 3px solid var(--brown-tape);
    box-shadow: 0 0.25rem 0.5rem rgba(0, 0, 0, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 200ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .vm-disk-slot:hover .vm-disk,
  .vm-disk-slot:focus-visible .vm-disk {
    transform: scale(1.06) rotate(6deg);
  }

  /* Mission 10: a ring of photo-window swatches replaces Mission 08's
     sprocket-hole ring (that radiating-line pattern read wrong and
     must not come back) and its single colored hub. Each window
     rotates BY its own placement angle with no counter-rotation —
     that's what makes them fan progressively around the ring like a
     real disc, instead of all staying upright. Distances below are
     this disc's own 9rem (144px) diameter scaled proportionally from
     the approved reference's 170px-diameter mockup, not copied
     pixel-for-pixel. */
  .vm-window {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1.125rem;
    height: 0.875rem;
    border-radius: 2px;
    background: var(--disk-color, var(--view-master));
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.3);
    transform-origin: center;
    transform: translate(-50%, -50%) rotate(var(--angle)) translateY(-3.25rem);
  }

  /* Small punched notches at the rim, between the windows — no
     radiating lines across the face. */
  .vm-notch {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.4rem;
    height: 0.55rem;
    background: black;
    transform-origin: center;
    transform: translate(-50%, -50%) rotate(var(--angle)) translateY(-4.3rem);
  }

  .vm-center-hub {
    position: relative;
    z-index: 1;
    width: 5.5rem;
    height: 5.5rem;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1px;
    text-align: center;
    padding: 0 0.375rem;
  }

  .vm-up-mark {
    font-size: 0.55rem;
    color: var(--brown-tape);
    opacity: 0.55;
    line-height: 1;
  }

  .vm-hole {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: black;
    margin: 0.125rem 0 0.25rem;
  }

  .vm-disc-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.6rem;
    line-height: 1.15;
    color: var(--brown-tape);
    max-width: 5rem;
  }

  .vm-disc-sub {
    font-family: var(--font-body);
    font-size: 0.55rem;
    color: var(--brown-tape);
    opacity: 0.6;
    margin-top: 1px;
  }

  /* -------------------- Viewer dialog -------------------- */
  .vm-viewer {
    padding: 0;
    border: none;
    border-radius: var(--radius-md);
    background: transparent;
    max-width: min(26rem, 92vw);
    width: 100%;
  }

  .vm-viewer::backdrop {
    background: rgba(0, 0, 0, 0.6);
  }

  .vm-viewer__body {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--space-3);
  }

  @keyframes vm-viewer-in {
    from {
      transform: scale(0.85);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  .vm-viewer__body.vm-entering {
    animation: vm-viewer-in 320ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .vm-viewer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    width: 100%;
    margin-bottom: var(--space-3);
  }

  .vm-viewer__title {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--vintage-sky);
  }

  .vm-viewer__close {
    width: 2.75rem;
    height: 2.75rem;
    flex: 0 0 auto;
    border-radius: 50%;
    border: 2px solid var(--vintage-sky);
    background: var(--view-master);
    color: var(--vintage-sky);
    font-size: 1rem;
    cursor: pointer;
  }

  .vm-viewer__close:hover {
    background: var(--polaroid-sunset);
  }

  /* The classic two-piece View-Master silhouette: a wide eyecup
     housing narrowing into a lower body, done as two stacked shapes
     (matching the approved reference) rather than Mission 08's single
     flat rectangle. */
  .vm-toy {
    position: relative;
    width: 100%;
  }

  .vm-eyecup-housing {
    width: 100%;
    height: 3.75rem;
    background: var(--view-master);
    border-radius: 1.5rem 1.5rem 2.25rem 2.25rem / 1.5rem 1.5rem 1.75rem 1.75rem;
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.4);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
  }

  .vm-eyecup {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    /* Plain black, same established precedent as the eyepiece tunnel
       and the disc's rim notches — not a new invented neutral. */
    background: black;
    box-shadow:
      inset 0 0 0 0.2rem rgba(0, 0, 0, 0.4),
      0 0.125rem 0.25rem rgba(0, 0, 0, 0.3);
  }

  .vm-lower-body {
    width: 88%;
    margin: -0.875rem auto 0;
    background: var(--brown-tape);
    border-radius: 0 0 1.25rem 1.25rem;
    box-shadow: 0 0.625rem 1.25rem rgba(0, 0, 0, 0.4);
    position: relative;
    padding: var(--space-3) var(--space-3) var(--space-4);
  }

  .vm-eyepiece {
    position: relative;
    aspect-ratio: 4 / 3;
    /* A gently elongated oval — the View-Master eyepiece tunnel, a
       real trait of the toy, not a decorative flourish. A much
       larger horizontal radius (e.g. 999px) tapers the corners so
       aggressively that the frame content gets clipped into a
       narrow lens shape, leaving distracting dark voids — confirmed
       by rendering it, not assumed. */
    border-radius: 3rem / 34%;
    /* Plain black, not a new invented neutral — same non-token
       "looking into an empty screen" precedent already used for the
       video modal's embed background since Mission 02
       (.reel-modal__embed { background: black }). */
    background: black;
    box-shadow:
      inset 0 0 0 0.375rem var(--vintage-sky),
      inset 0 0 1.5rem rgba(0, 0, 0, 0.8);
    overflow: hidden;
    cursor: pointer;
  }

  .vm-frame-stack {
    position: absolute;
    inset: 0;
  }

  .vm-frame {
    position: absolute;
    inset: 0;
    margin: 0;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3);
    text-align: center;
    background: var(--vintage-sky);
  }

  .vm-frame.is-active {
    display: flex;
  }

  .vm-frame .frame-media {
    width: 100%;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
  }

  .vm-frame figcaption {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.75rem;
    color: var(--brown-tape);
  }

  @keyframes vm-frame-in-forward {
    from {
      transform: translateX(60%) rotate(12deg);
      opacity: 0;
    }
    to {
      transform: translateX(0) rotate(0deg);
      opacity: 1;
    }
  }

  @keyframes vm-frame-in-back {
    from {
      transform: translateX(-60%) rotate(-12deg);
      opacity: 0;
    }
    to {
      transform: translateX(0) rotate(0deg);
      opacity: 1;
    }
  }

  .vm-frame.frame-enter-forward {
    animation: vm-frame-in-forward 380ms ease-out;
  }

  .vm-frame.frame-enter-back {
    animation: vm-frame-in-back 380ms ease-out;
  }

  .vm-play-badge {
    position: absolute;
    top: 0.625rem;
    left: 0.625rem;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    pointer-events: none;
  }

  .vm-back-hint {
    position: absolute;
    top: 50%;
    left: 0.75rem;
    transform: translateY(-50%);
    color: var(--vintage-sky);
    opacity: 0.5;
    font-size: 1.5rem;
    pointer-events: none;
  }

  /* Mounted on the lower body's right edge, angled out from the body
     rather than centered below the eyepiece (Mission 08's placement)
     — matching the approved reference's .vm-lever-mount/.vm-lever
     treatment. Straight at rest; presses/rotates down on activation,
     then springs back (see the script's vm-pressed toggle below). */
  .vm-lever-mount {
    position: absolute;
    right: -1.375rem;
    top: 1.5rem;
    width: 2.75rem;
    height: 5.5rem;
  }

  .vm-lever {
    position: absolute;
    right: 0;
    top: 0;
    width: 2.75rem; /* >= 44px, the minimum comfortable touch target */
    height: 5rem;
    background: linear-gradient(
      180deg,
      var(--view-master),
      color-mix(in srgb, var(--view-master) 65%, black)
    );
    border: none;
    border-radius: 0.375rem 0.75rem 0.75rem 0.375rem;
    box-shadow: 0.125rem 0.1875rem 0.375rem rgba(0, 0, 0, 0.5);
    cursor: pointer;
    transform-origin: top center;
    transition: transform 180ms cubic-bezier(0.3, 0.6, 0.3, 1);
  }

  .vm-lever::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 0.5rem;
    transform: translateX(-50%);
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.25);
  }

  .vm-lever.vm-pressed {
    transform: rotate(22deg) translateY(0.375rem);
  }

  .vm-dots-wrap {
    display: flex;
    justify-content: center;
    margin-top: var(--space-3);
  }

  /* [hidden] alone isn't enough here: our own unconditional
     `.vm-dots { display: flex }` rule below is author-origin and
     beats the UA stylesheet's `[hidden] { display: none }` in the
     cascade regardless of specificity (same lesson as Mission 03's
     mobile nav toggle) — so the hidden dot-group would otherwise
     stay visible. */
  .vm-dots[hidden] {
    display: none;
  }

  .vm-dots {
    display: flex;
    gap: 0.375rem;
  }

  .vm-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--vintage-sky);
    opacity: 0.3;
  }

  .vm-dot.is-active {
    opacity: 1;
  }

  /* -------------------- Video / photo full-view modals -------------------- */
  .vm-modal {
    padding: 0;
    border: none;
    border-radius: var(--radius-md);
    max-width: 32rem;
    width: 90vw;
  }

  .vm-modal::backdrop {
    background: rgba(0, 0, 0, 0.6);
  }

  .vm-modal__frame {
    background: var(--vintage-sky);
    border: 0.5rem solid var(--brown-tape);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    position: relative;
  }

  .vm-modal__close {
    position: absolute;
    top: -0.75rem;
    right: -0.75rem;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--view-master);
    color: var(--vintage-sky);
    border: 2px solid var(--vintage-sky);
    font-size: 1rem;
    cursor: pointer;
  }

  .vm-modal__embed {
    aspect-ratio: 16 / 9;
    background: black;
  }

  .vm-modal__embed iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .vm-modal__photo {
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
  }

  .vm-modal__note {
    margin: var(--space-2) 0 0;
    font-size: 0.75rem;
    color: var(--brown-tape);
    opacity: 0.75;
    text-align: center;
  }
</style>

<script>
  function initViewMaster() {
    const shelf = document.getElementById("vmShelf");
    const viewer = document.getElementById("vmViewer") as HTMLDialogElement | null;
    const viewerBody = viewer?.querySelector<HTMLElement>(".vm-viewer__body");
    const viewerTitle = document.getElementById("vmViewerTitle");
    const viewerClose = viewer?.querySelector<HTMLButtonElement>(".vm-viewer__close");
    const eyepiece = document.getElementById("vmEyepiece");
    const lever = viewer?.querySelector<HTMLButtonElement>(".vm-lever");
    const frameStacks = Array.from(
      document.querySelectorAll<HTMLElement>(".vm-frame-stack"),
    );
    const dotsGroups = Array.from(document.querySelectorAll<HTMLElement>(".vm-dots"));

    const videoModal = document.getElementById("vmVideoModal") as HTMLDialogElement | null;
    const videoIframe = document.getElementById("vmVideoIframe") as HTMLIFrameElement | null;
    const photoModal = document.getElementById("vmPhotoModal") as HTMLDialogElement | null;
    const photoText = document.getElementById("vmPhotoText");

    if (!shelf || !viewer || !eyepiece) return;

    let currentDisk = 0;
    let currentFrame = 0;

    function framesFor(diskIndex: number) {
      const stack = frameStacks.find(
        (s) => s.dataset.diskIndex === String(diskIndex),
      );
      return stack ? Array.from(stack.querySelectorAll<HTMLElement>(".vm-frame")) : [];
    }

    function render(direction: "forward" | "back") {
      const frames = framesFor(currentDisk);
      frames.forEach((f, i) => f.classList.toggle("is-active", i === currentFrame));

      const dots = dotsGroups.find((d) => d.dataset.diskIndex === String(currentDisk));
      if (dots) {
        Array.from(dots.querySelectorAll<HTMLElement>(".vm-dot")).forEach((d, i) =>
          d.classList.toggle("is-active", i === currentFrame),
        );
      }

      const activeFrame = frames[currentFrame];
      if (activeFrame) {
        activeFrame.classList.remove("frame-enter-forward", "frame-enter-back");
        void activeFrame.offsetWidth;
        activeFrame.classList.add(
          direction === "back" ? "frame-enter-back" : "frame-enter-forward",
        );
      }
    }

    function goTo(index: number, direction: "forward" | "back") {
      const frames = framesFor(currentDisk);
      if (!frames.length) return;
      currentFrame = (index + frames.length) % frames.length;
      render(direction);
    }

    function openViewer(diskIndex: number) {
      currentDisk = diskIndex;
      currentFrame = 0;

      frameStacks.forEach((s) =>
        s.toggleAttribute("hidden", s.dataset.diskIndex !== String(diskIndex)),
      );
      dotsGroups.forEach((d) =>
        d.toggleAttribute("hidden", d.dataset.diskIndex !== String(diskIndex)),
      );

      const slot = shelf?.querySelector<HTMLElement>(
        `.vm-disk-slot[data-disk-index="${diskIndex}"]`,
      );
      if (viewerTitle) viewerTitle.textContent = slot?.dataset.location ?? "";

      render("forward");
      viewer?.showModal();

      if (viewerBody) {
        viewerBody.classList.remove("vm-entering");
        void viewerBody.offsetWidth;
        viewerBody.classList.add("vm-entering");
      }
    }

    function closeViewer() {
      viewer?.close();
    }

    shelf.querySelectorAll<HTMLButtonElement>(".vm-disk-slot").forEach((slot) => {
      slot.addEventListener("click", () => {
        const index = parseInt(slot.dataset.diskIndex ?? "0", 10);
        openViewer(index);
      });
    });

    viewerClose?.addEventListener("click", closeViewer);
    // Escape-to-close is native <dialog> behavior — no extra JS needed.

    lever?.addEventListener("click", () => {
      // Visual-only: presses/rotates down, then springs back — matches
      // the approved reference's press animation. Does not change what
      // the lever does (still just advances one frame, same as
      // Mission 08).
      lever.classList.add("vm-pressed");
      setTimeout(() => lever.classList.remove("vm-pressed"), 180);
      goTo(currentFrame + 1, "forward");
    });

    function openFull() {
      const frames = framesFor(currentDisk);
      const frame = frames[currentFrame];
      if (!frame) return;
      const type = frame.dataset.frameType;
      if (type === "video") {
        const id = frame.dataset.videoId;
        if (videoModal && videoIframe && id) {
          videoIframe.src = `https://www.youtube.com/embed/${id}`;
          videoModal.showModal();
        }
      } else {
        const label = frame.querySelector("figcaption")?.textContent ?? "";
        const bodyText = frame.querySelector(".frame-media span")?.textContent ?? "";
        if (photoModal && photoText) {
          photoText.textContent = `${bodyText} — ${label}`;
          photoModal.showModal();
        }
      }
    }

    eyepiece.addEventListener("click", (event) => {
      const rect = eyepiece.getBoundingClientRect();
      const clickX = (event as MouseEvent).clientX - rect.left;
      if (clickX < rect.width / 2) {
        goTo(currentFrame - 1, "back");
      } else {
        openFull();
      }
    });

    function closeVideoModal() {
      if (videoIframe) videoIframe.src = "";
      videoModal?.close();
    }

    videoModal
      ?.querySelector<HTMLButtonElement>(".vm-modal__close")
      ?.addEventListener("click", closeVideoModal);
    videoModal?.addEventListener("click", (event) => {
      if (event.target === videoModal) closeVideoModal();
    });
    videoModal?.addEventListener("close", () => {
      if (videoIframe) videoIframe.src = "";
    });

    photoModal
      ?.querySelector<HTMLButtonElement>(".vm-modal__close")
      ?.addEventListener("click", () => photoModal.close());
    photoModal?.addEventListener("click", (event) => {
      if (event.target === photoModal) photoModal.close();
    });
  }

  // astro:page-load alone (not also an immediate call) covers both the
  // initial load and every soft-navigation swap — an additional
  // immediate call would double-bind every listener here (same
  // astro:page-load double-init trap fixed across Header.astro/
  // Reel.astro/TransitionOverlay.astro since Mission 04).
  document.addEventListener("astro:page-load", initViewMaster);
</script>
