---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageAccentBar from "../components/PageAccentBar.astro";

import camiseta from "../assets/merch/camiseta-audiocassettes.webp";
import gorra from "../assets/merch/gorra-audiocassettes.webp";
import pin from "../assets/merch/pin-audiocassettes.webp";
import tazaLogo from "../assets/merch/taza-logo-audiocassettes.webp";
import tazaCerro from "../assets/merch/taza-cerro-audiocassettes.webp";
import cordon from "../assets/merch/cordon-audiocassettes.webp";

/**
 * Mission 13 — merch catalog, order-by-email, no real purchase flow.
 *
 * PLACEHOLDER ORDER ADDRESS — Esteban will replace this once a real
 * inbox is set up for merch orders. This is the ONLY place it appears;
 * every item's mailto: link is built from this one constant.
 */
const ORDER_EMAIL = "pedidos@audiocassettes.com";

interface MerchItem {
  slug: string;
  name: string;
  image: ImageMetadata;
  alt: string;
}

const items: MerchItem[] = [
  {
    slug: "camiseta",
    name: "camiseta",
    image: camiseta,
    alt: "Camiseta raglán audiocassettes, cuerpo crema y mangas azules, con el wordmark en el pecho.",
  },
  {
    slug: "gorra",
    name: "gorra",
    image: gorra,
    alt: "Gorra trucker audiocassettes, copa crema y café y visera roja, con el wordmark al frente.",
  },
  {
    slug: "pin",
    name: "pin",
    image: pin,
    alt: "Pin redondo audiocassettes con diseño de anillos concéntricos en los colores de la marca.",
  },
  {
    slug: "taza-logo",
    name: "taza — diseño clásico",
    image: tazaLogo,
    alt: "Taza esmaltada audiocassettes con el wordmark y el isologo.",
  },
  {
    slug: "taza-cerro",
    name: "taza — diseño cerro",
    image: tazaCerro,
    alt: "Taza esmaltada audiocassettes con diseño de montaña estilo Cerro Chirripó en los colores de la marca.",
  },
  {
    slug: "cordon",
    name: "cordón",
    image: cordon,
    alt: "Cordón audiocassettes con patrón de rayas en los colores de la marca y el wordmark repetido.",
  },
];

function mailtoFor(item: MerchItem): string {
  const subject = `Pedido: ${item.name}`;
  const body = [
    `Hola,`,
    ``,
    `Quiero pedir: ${item.name}.`,
    `Mi color preferido es: [escribí aquí tu color preferido]`,
    ``,
    `¡Gracias!`,
  ].join("\n");
  return `mailto:${ORDER_EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
}
---

<BaseLayout title="el estuche">
  <section class="stub" style="--page-accent: var(--brown-tape);">
    <h1>el estuche</h1>
    <PageAccentBar />
    <p class="intro">
      Piezas de merch de audiocassettes, hechas a pedido. Escribinos por
      correo para elegir el color de la tuya.
    </p>

    <div class="merch-grid">
      {
        items.map((item) => (
          <article class="merch-card">
            <div class="merch-card__photo">
              <Image src={item.image} alt={item.alt} width={item.image.width} height={item.image.height} />
            </div>
            <h2 class="merch-card__name">{item.name}</h2>
            <a class="merch-card__order" href={mailtoFor(item)}>
              ordenar
            </a>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .stub {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-6) var(--space-4);
  }

  .intro {
    max-width: 34rem;
    margin: var(--space-3) 0 0;
    line-height: 1.6;
  }

  .merch-grid {
    margin-top: var(--space-5);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  @media (max-width: 50rem) {
    .merch-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 26.25rem) {
    .merch-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Same card chrome already established sitewide (NotasDeCintaTeaser's
     .card — border/tint literally are var(--brown-tape) at low alpha,
     see that component's own comment history) -- reused here for
     consistency rather than inventing new card styling. */
  .merch-card {
    background: rgba(89, 51, 44, 0.06);
    border: 2px solid var(--brown-tape);
    border-radius: var(--radius-sm);
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-2);
  }

  /* Fixed-aspect box, image scaled with object-fit: contain -- the six
     source photos vary wildly in native aspect ratio (a tall t-shirt
     crop vs. a wide lanyard banner vs. near-square mugs/pin/cap), so a
     cropped fill would badly distort several of them. All six photos
     already share the same vintage-sky backdrop as the page itself, so
     the box's own background matches it -- any letterboxed space around
     a non-matching-ratio photo reads as continuous background, not a
     visible box. */
  .merch-card__photo {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: var(--vintage-sky);
    border-radius: var(--radius-sm);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .merch-card__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .merch-card__name {
    font-size: 1rem;
    font-weight: 600;
  }

  /* Same visual treatment as the site's other .btn-solid buttons
     (Hero.astro, NotasDeCintaTeaser.astro) -- brown-tape fill,
     vintage-sky text, lowercase, font-body bold -- reused here rather
     than inventing new button chrome. */
  .merch-card__order {
    margin-top: auto;
    display: inline-block;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    text-transform: lowercase;
    text-decoration: none;
    padding: 0.6875rem 1.5rem;
    border-radius: 2px;
    background: var(--brown-tape);
    color: var(--vintage-sky);
    border: 2px solid var(--brown-tape);
  }

  .merch-card__order:hover {
    background: var(--view-master);
    border-color: var(--view-master);
  }
</style>
