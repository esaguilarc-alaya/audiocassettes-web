---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageAccentBar from "../components/PageAccentBar.astro";
import CassettePlayer from "../components/CassettePlayer.astro";

/**
 * Mission 14 (missions/MISSION_14_lado-a-lado-b-player.md): four sample
 * cassettes, carried over unchanged from
 * reference/lado-a-lado-b-player-flow-reference.html's own approved
 * demo data (Esteban already reviewed this exact set) — not invented
 * here. Real cassette/track data (recordings, real durations, real
 * lyrics) is a later mission once Esteban provides it.
 * TODO: replace the remaining placeholder cassette/track data once
 * more recordings exist.
 *
 * Mission 16 (missions/MISSION_16_real-audio-lado-a.md): the first
 * cassette's lado A now has two real tracks with real audioSrc/lyrics
 * (see CassettePlayer.astro's REAL_LYRICS) — Esteban's explicit
 * decision, replacing the two placeholder tracks that were there.
 * This cassette's title and every one of its tracks' `loc` (both
 * sides) were renamed from "cerro chirripó" to "Audiocassettes" per
 * that same decision; the `id: "cerro"` key itself is internal/not
 * user-facing and was deliberately left unchanged.
 *
 * Judgment call, flagged per the mission's own instruction: "Niebla"
 * (lado B, still a placeholder track, no real audio yet) had its
 * `loc` renamed to "Audiocassettes" too, purely for consistency within
 * this one cassette — Esteban only explicitly asked about lado A. If
 * he'd rather leave "Niebla" as "cerro chirripó" until it also gets
 * real audio, that's a one-line revert of this entry's `loc` value.
 *
 * Mission 17 (missions/MISSION_17_video-sync.md): "Tarde En La Mañana"
 * only, adds `videoId` (the real, approved YouTube video) and
 * `videoOffset` (2.8s — Esteban's own stated number after listening,
 * not recomputed here) — the video's own soundtrack starts 2.8s later
 * than our uploaded audio, so it plays muted and kept in sync against
 * the real <audio> element (see CassettePlayer.astro). "El Ayer" and
 * every placeholder track are untouched, still showing the placeholder
 * video box exactly as Mission 14/15/16 built it.
 */
const cassettes = [
  {
    id: "cerro",
    title: "grabaciones — Audiocassettes",
    loc: "las cintas · locación 1",
    a: [
      {
        title: "Tarde En La Mañana",
        loc: "Audiocassettes",
        dur: "5:06",
        audioSrc: "/audio/tarde-en-la-manana.mp3",
        videoId: "4gBwAFS-iXs",
        videoOffset: 2.8,
      },
      {
        title: "El Ayer",
        loc: "Audiocassettes",
        dur: "3:06",
        audioSrc: "/audio/el-ayer.mp3",
      },
    ],
    b: [{ title: "Niebla", loc: "Audiocassettes", dur: "4:05" }],
  },
  {
    id: "playa",
    title: "grabaciones — guanacaste",
    loc: "las cintas · locación 2",
    a: [{ title: "Marea", loc: "guanacaste", dur: "3:12" }],
    b: [
      { title: "Sal y sol", loc: "guanacaste", dur: "3:33" },
      { title: "Vuelta a casa", loc: "guanacaste", dur: "2:47" },
    ],
  },
  {
    id: "ciudad",
    title: "grabaciones — san josé",
    loc: "las cintas · locación 3",
    a: [{ title: "Casa de amigos", loc: "san josé", dur: "3:02" }],
    b: [{ title: "Luces de neón", loc: "san josé", dur: "3:50" }],
  },
  {
    id: "bosque",
    title: "grabaciones — monteverde",
    loc: "las cintas · locación 4",
    a: [{ title: "Verde", loc: "monteverde", dur: "3:20" }],
    b: [{ title: "Camino angosto", loc: "monteverde", dur: "2:55" }],
  },
];
---

<BaseLayout title="lado a / lado b">
  <section class="stub" style="--page-accent: var(--view-master);">
    <h1>lado a / lado b</h1>
    <PageAccentBar />
    <p>
      Cuatro grabaciones de muestra — tocá un cassette para ver las
      canciones de cada lado.
    </p>
    <CassettePlayer cassettes={cassettes} />
  </section>
</BaseLayout>

<style>
  .stub {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-6) var(--space-4);
  }

  .stub > p {
    max-width: 34rem;
    margin: var(--space-3) 0 0;
    opacity: 0.85;
  }
</style>
