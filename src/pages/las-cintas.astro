---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageAccentBar from "../components/PageAccentBar.astro";
import ViewMasterShelf from "../components/ViewMasterShelf.astro";

/**
 * Two placeholder disks — Mission 02 scope, restructured into a
 * shelf + viewer in Mission 08
 * (missions/MISSION_08_las-cintas-viewmaster.md). Location names,
 * frame content, and video IDs are unchanged from Mission 02/03 —
 * only the presentation (always-open Reel cards → a disk shelf you
 * click into a shared viewer) changed. Location names are
 * deliberately unmistakable placeholders (Standing Rule 3), not
 * invented-but-plausible place names. Each disk mixes frame types
 * and includes at least one video frame and one photo-like frame.
 * Video IDs are obviously-fake placeholder strings, never a real,
 * working video ID.
 */
const disks = [
  {
    id: "disk-1",
    location: "[ubicación real aquí]",
    frames: [
      { type: "photo" as const, label: "foto 1" },
      {
        type: "video" as const,
        label: "video 1",
        videoId: "PLACEHOLDER_VIDEO_ID_1",
      },
      { type: "band-photo" as const, label: "foto de banda 1" },
      { type: "art" as const, label: "arte 1" },
    ],
  },
  {
    id: "disk-2",
    location: "[ubicación real aquí #2]",
    frames: [
      { type: "art" as const, label: "arte 2" },
      { type: "photo" as const, label: "foto 2" },
      {
        type: "video" as const,
        label: "video 2",
        videoId: "PLACEHOLDER_VIDEO_ID_2",
      },
      { type: "band-photo" as const, label: "foto de banda 2" },
    ],
  },
];
---

<BaseLayout title="las cintas">
  <section class="stub" style="--page-accent: var(--retro-pop);">
    <h1>las cintas</h1>
    <PageAccentBar />
    <p>
      Cada cinta es una sesión — un lugar. Tocá un disco para cargarlo en
      el visor: dale a la palanca para avanzar, o tocá el lado izquierdo
      del visor para retroceder.
    </p>
    <ViewMasterShelf disks={disks} />
  </section>
</BaseLayout>

<style>
  .stub {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-6) var(--space-4);
  }

  .stub > p {
    max-width: 34rem;
    margin: var(--space-3) 0 var(--space-5);
    opacity: 0.85;
  }
</style>
